# Pinned upstream inputs for KitPlex Dual (Plex Mono + Plex Sans SC)
# Reproducible build: change these deliberately; record why in the commit.

# --- IBM Plex Mono (Latin / programming) ------------------------------------
# Package release: https://github.com/IBM/plex/releases/tag/%40ibm/plex-mono%402.5.0
# Font version inside TTF: Version 2.005 (name ID 5)
PLEX_MONO_REPO=https://github.com/IBM/plex
PLEX_MONO_RELEASE_TAG='@ibm/plex-mono@2.5.0'
PLEX_MONO_ZIP_URL='https://github.com/IBM/plex/releases/download/%40ibm/plex-mono%402.5.0/ibm-plex-mono.zip'
PLEX_MONO_ZIP_SHA256=6d23f01257663d8cc49a0d64c22ced630b79e0e2a0ac08a0da86e9a38bbc481c
# Paths inside the zip (complete TTF, unhinted path not shipped for Mono)
PLEX_MONO_TTF_REGULAR=ibm-plex-mono/fonts/complete/ttf/IBMPlexMono-Regular.ttf
PLEX_MONO_TTF_BOLD=ibm-plex-mono/fonts/complete/ttf/IBMPlexMono-Bold.ttf
# Upstream default mono cell (used to compute X scale → EN_ADV)
PLEX_MONO_SRC_ADV=600

# --- IBM Plex Sans SC (CJK) -------------------------------------------------
# Package release: https://github.com/IBM/plex/releases/tag/%40ibm/plex-sans-sc%401.1.0
# Font version inside TTF: Version 1.000 (name ID 5)
PLEX_SANS_SC_REPO=https://github.com/IBM/plex
PLEX_SANS_SC_RELEASE_TAG='@ibm/plex-sans-sc@1.1.0'
PLEX_SANS_SC_ZIP_URL='https://github.com/IBM/plex/releases/download/%40ibm/plex-sans-sc%401.1.0/ibm-plex-sans-sc.zip'
PLEX_SANS_SC_ZIP_SHA256=0aabd737c8ef0206892b912c759101c10b86c6244be99f2e6b57c6905c716837
# Prefer hinted complete TTF (screen coding); switch to unhinted/ if needed
PLEX_SANS_SC_TTF_REGULAR=ibm-plex-sans-sc/fonts/complete/ttf/hinted/IBMPlexSansSC-Regular.ttf
PLEX_SANS_SC_TTF_BOLD=ibm-plex-sans-sc/fonts/complete/ttf/hinted/IBMPlexSansSC-Bold.ttf

# --- Product metrics (chosen after 500/1000 · 550/1100 · 600/1200 bake-off) --
# EN 550 / CJK 1100 ≈ Mono compressed 8.3% + CJK +50 units side bearing each side
EN_ADV=550
CJK_ADV=1100
UPM=1000

# --- Product naming (derivative; do NOT reuse reserved "Plex") ---------------
FAMILY_NAME='KitPlex Dual'
FAMILY_PS=KitPlexDual
# Optional suffix for experiments (empty for product)
FAMILY_SUFFIX=

# --- Vertical metrics (coding-oriented blend) -------------------------------
HHEA_ASCENT=1025
HHEA_DESCENT=-275
HHEA_LINE_GAP=0
OS2_TYPO_ASCENDER=880
OS2_TYPO_DESCENDER=-220
OS2_TYPO_LINE_GAP=0
OS2_WIN_ASCENT=1060
OS2_WIN_DESCENT=300
