# Pinned upstream inputs for LilexSansSC NFM
# (Lilex Latin/programming + Plex Sans SC CJK + Nerd Font Mono, dual-width)
# Reproducible build: change these deliberately; record why in the commit.

# --- Lilex (Latin / programming, ligatures + OT features) -------------------
# Release: https://github.com/mishamyrt/Lilex/releases/tag/2.700
# Extended IBM Plex Mono with programming ligatures / stylistic sets.
# Font version inside TTF: Version 2.700 (name ID 5)
LILEX_REPO=https://github.com/mishamyrt/Lilex
LILEX_RELEASE_TAG='2.700'
LILEX_ZIP_URL='https://github.com/mishamyrt/Lilex/releases/download/2.700/Lilex.zip'
LILEX_ZIP_SHA256=34310edb4ba749f772d42b88e3eec4a6318527e75ceeaa96cfc556ee35366fbc
# Paths inside the zip (static TTF)
LILEX_TTF_REGULAR=ttf/Lilex-Regular.ttf
LILEX_TTF_BOLD=ttf/Lilex-Bold.ttf
# Upstream default mono cell (used to compute X scale → EN_ADV)
LILEX_SRC_ADV=600

# --- IBM Plex Sans SC (CJK) -------------------------------------------------
# Package release: https://github.com/IBM/plex/releases/tag/%40ibm/plex-sans-sc%401.1.0
# Tag peels to commit 222657a0…; we pin the two hinted complete TTFs directly
# (~8 MB each) instead of the full release zip (~500 MB).
# Font version inside TTF: Version 1.000 (name ID 5)
PLEX_SANS_SC_REPO=https://github.com/IBM/plex
PLEX_SANS_SC_RELEASE_TAG='@ibm/plex-sans-sc@1.1.0'
PLEX_SANS_SC_COMMIT=222657a016f31e6d913ede88520de7dec84dc81b
PLEX_SANS_SC_TTF_REGULAR_URL="https://raw.githubusercontent.com/IBM/plex/${PLEX_SANS_SC_COMMIT}/packages/plex-sans-sc/fonts/complete/ttf/hinted/IBMPlexSansSC-Regular.ttf"
PLEX_SANS_SC_TTF_BOLD_URL="https://raw.githubusercontent.com/IBM/plex/${PLEX_SANS_SC_COMMIT}/packages/plex-sans-sc/fonts/complete/ttf/hinted/IBMPlexSansSC-Bold.ttf"
PLEX_SANS_SC_TTF_REGULAR_SHA256=012e587c5a78d25f456057614b880fc7450b748c352573d8052245df2a71158a
PLEX_SANS_SC_TTF_BOLD_SHA256=3e94ef1df394eae336cc1bc98f2160b58e2cab186f47d820e4c808aef1f4e28f
# Legacy full-zip pin (optional fallback; not used by 01-fetch-sources.sh)
PLEX_SANS_SC_ZIP_URL='https://github.com/IBM/plex/releases/download/%40ibm/plex-sans-sc%401.1.0/ibm-plex-sans-sc.zip'
PLEX_SANS_SC_ZIP_SHA256=0aabd737c8ef0206892b912c759101c10b86c6244be99f2e6b57c6905c716837

# --- Product metrics (same grid as prior Plex Mono bake-off) ----------------
# EN 550 / CJK 1100 ≈ Lilex compressed 8.3% from native 600 + CJK recentred
EN_ADV=550
CJK_ADV=1100
UPM=1000

# --- Optical weight match (CJK pathops embolden before merge) ---------------
# Calibrated by scripts/calibrate-stroke.sh against Lilex at product X-scale
# (600 → EN_ADV). Metric: scanline vertical-stem median (serif/tools/).
#   Regular Latin v≈77  → CJK was ≈65.8 (s=0) → embolden s=5  → ≈78.3
#   Bold    Latin v≈138 → CJK was ≈130  (s=0) → embolden s=4  → ≈138
# Plex Sans SC masters are lighter than Lilex stems once Latin is compressed;
# embolden closes the “中文比英文细” gap without swapping SC weight masters.
# Re-run: ./scripts/calibrate-stroke.sh
CJK_EMBOLDEN_REGULAR=5
CJK_EMBOLDEN_BOLD=4

# --- Product naming ---------------------------------------------------------
# Same recipe as serif's "SarasaNZSSlab NFM":
#   Lilex     = Lilex (Latin / programming + ligatures / OT features)
#   SansSC    = IBM Plex Sans SC (CJK)
#   NFM       = Nerd Font Mono product
# Intermediate (pre-Nerd) keeps "Dual" so merge output is distinct.
# Windows name ID 1 must stay ≤ 31 chars ("LilexSansSC NFM" = 15).
# Lilex OFL RFN is "Lilex"; Plex OFL RFN is "Plex". Compound is a project
# source-encoding label — review RFN before public OFL redistribution.
BASE_FAMILY_NAME='LilexSansSC Dual'
BASE_FAMILY_PS=LilexSansSCDual
FAMILY_NAME='LilexSansSC NFM'
FAMILY_PS=LilexSansSCNFM
# File stem (= FAMILY_PS); used by verify / package scripts
PRODUCT_STEM=LilexSansSCNFM
# Optional suffix for experiments (empty for product)
FAMILY_SUFFIX=

# --- Vertical metrics (coding-oriented blend) -------------------------------
HHEA_ASCENT=1025
HHEA_DESCENT=-275
HHEA_LINE_GAP=0
OS2_TYPO_ASCENDER=880
OS2_TYPO_DESCENDER=-220
OS2_TYPO_LINE_GAP=0
OS2_WIN_ASCENT=1060
OS2_WIN_DESCENT=300

# --- Nerd Fonts patcher ------------------------------------------------------
# https://github.com/ryanoasis/nerd-fonts/releases
# Same pin as serif/ / pixel/ for a consistent icon set across products.
NERD_FONTS_TAG=v3.4.0
NERD_FONTS_PATCHER_URL=https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/FontPatcher.zip
# The zip was fetched unverified until KIT-275. All five families pin the same
# URL, so Nix collapses them to a single store path — but only if the hash
# matches too, which makes this line the thing that keeps them collapsed.
NERD_FONTS_PATCHER_SHA256=a8f11e511ed7c69e96680858c06b50a643ea7752e26d5cd13dd5e5cc53ab1760
NERD_FONTS_DOCKER_IMAGE=nerdfonts/patcher@sha256:4e820b4e5484447abaa6499a1a7448b83d0b8ca63cfe71df9f594336025a504a
# auto | docker | fontforge
NERD_PATCH_METHOD=auto
