# Pinned upstream inputs for LilexSansSC Dual
# (Lilex Latin/programming + Plex Sans SC CJK, dual-width coding face)
# Reproducible build: change these deliberately; record why in the commit.

# --- Lilex (Latin / programming, ligatures + OT features) -------------------
# Release: https://github.com/mishamyrt/Lilex/releases/tag/2.700
# Extended IBM Plex Mono with programming ligatures / stylistic sets.
# Font version inside TTF: Version 2.700 (name ID 5)
LILEX_REPO=https://github.com/mishamyrt/Lilex
LILEX_RELEASE_TAG='2.700'
LILEX_ZIP_URL='https://github.com/mishamyrt/Lilex/releases/download/2.700/Lilex.zip'
LILEX_ZIP_SHA256=34310edb4ba749f772d42b88e3eec4a6318527e75ceeaa96cfc556ee35366fbc
# Paths inside the zip (static TTF)
LILEX_TTF_REGULAR=ttf/Lilex-Regular.ttf
LILEX_TTF_BOLD=ttf/Lilex-Bold.ttf
# Upstream default mono cell (used to compute X scale → EN_ADV)
LILEX_SRC_ADV=600

# --- IBM Plex Sans SC (CJK) -------------------------------------------------
# Package release: https://github.com/IBM/plex/releases/tag/%40ibm/plex-sans-sc%401.1.0
# Font version inside TTF: Version 1.000 (name ID 5)
PLEX_SANS_SC_REPO=https://github.com/IBM/plex
PLEX_SANS_SC_RELEASE_TAG='@ibm/plex-sans-sc@1.1.0'
PLEX_SANS_SC_ZIP_URL='https://github.com/IBM/plex/releases/download/%40ibm/plex-sans-sc%401.1.0/ibm-plex-sans-sc.zip'
PLEX_SANS_SC_ZIP_SHA256=0aabd737c8ef0206892b912c759101c10b86c6244be99f2e6b57c6905c716837
# Prefer hinted complete TTF (screen coding); switch to unhinted/ if needed
PLEX_SANS_SC_TTF_REGULAR=ibm-plex-sans-sc/fonts/complete/ttf/hinted/IBMPlexSansSC-Regular.ttf
PLEX_SANS_SC_TTF_BOLD=ibm-plex-sans-sc/fonts/complete/ttf/hinted/IBMPlexSansSC-Bold.ttf

# --- Product metrics (same grid as prior Plex Mono bake-off) ----------------
# EN 550 / CJK 1100 ≈ Lilex compressed 8.3% from native 600 + CJK recentred
EN_ADV=550
CJK_ADV=1100
UPM=1000

# --- Product naming ---------------------------------------------------------
# Same recipe as serif's "SarasaNZSSlab NFM":
#   Lilex     = Lilex (Latin / programming + ligatures / OT features)
#   SansSC    = IBM Plex Sans SC (CJK)
#   Dual      = dual-width 2:1 product (EN/CJK cells)
# Windows name ID 1 must stay ≤ 31 chars ("LilexSansSC Dual" = 16).
# Lilex OFL RFN is "Lilex"; Plex OFL RFN is "Plex". Compound is a project
# source-encoding label — review RFN before public OFL redistribution.
FAMILY_NAME='LilexSansSC Dual'
FAMILY_PS=LilexSansSCDual
# File stem (= FAMILY_PS); used by verify / package scripts
PRODUCT_STEM=LilexSansSCDual
# Optional suffix for experiments (empty for product)
FAMILY_SUFFIX=

# --- Vertical metrics (coding-oriented blend) -------------------------------
HHEA_ASCENT=1025
HHEA_DESCENT=-275
HHEA_LINE_GAP=0
OS2_TYPO_ASCENDER=880
OS2_TYPO_DESCENDER=-220
OS2_TYPO_LINE_GAP=0
OS2_WIN_ASCENT=1060
OS2_WIN_DESCENT=300
