# Pinned inputs for reproducible MonoSlab × Neo ZhiSong Opt build
SARASA_REPO=https://github.com/be5invis/Sarasa-Gothic.git
SARASA_REF=v1.0.40
SARASA_COMMIT=4b908c71116a3192f7a9889bd67b1939a891e527
# NAR hash of the source tree at SARASA_COMMIT, for fetchFromGitHub. The clone
# step verified the commit id, which pins history but not content delivery; this
# pins the bytes. 304 MiB unpacked — by far the largest single input in the repo
# and the reason the CI cache is layered (docs/caching.md).
# Re-derive: nix-prefetch-url --unpack --type sha256 \
#   https://github.com/be5invis/Sarasa-Gothic/archive/${SARASA_COMMIT}.tar.gz
SARASA_SRC_HASH=sha256-HmpKloXTSuluB/LyuAphIlDqNX6OCdROlpVCXmzFOBQ=

# LXGW Neo ZhiSong Plus (single master TTF)
LXGW_REPO=https://github.com/lxgw/LxgwNeoZhiSong
LXGW_TAG=v1.066
LXGW_ASSET=LXGWNeoZhiSongPlus.ttf
LXGW_URL=https://github.com/lxgw/LxgwNeoZhiSong/releases/download/v1.066/LXGWNeoZhiSongPlus.ttf
# Was fetched unverified until KIT-275.
LXGW_SHA256=279c973effc2811a827713ffa12706d556cab10b5067c0728400bf9e464f7008

# Optical weight match (pathops stroke embolden after scale to UPM 1000).
# Calibrated by tools/measure_stroke_width.py against IosevkaNSlab stems in
# Sarasa MonoSlab SC (same Latin as this build). Scanline vertical-stem medians:
#   Regular Latin v≈78 → CJK embolden s=7.5 (was 14; overshot ~+13 U on 中)
#   Bold    Latin v≈111 → CJK embolden s=24  (was 32; overshot ~+16 U)
# Re-run: ./scripts/calibrate-stroke.sh
CJK_EMBOLDEN_REGULAR=7.5
CJK_EMBOLDEN_BOLD=24
CJK_TARGET_UPM=1000

BUILD_TARGET=ttf-unhinted

# Nerd Fonts patcher (secondary step on out/*.ttf)
# https://github.com/ryanoasis/nerd-fonts/releases
NERD_FONTS_TAG=v3.4.0
NERD_FONTS_PATCHER_URL=https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/FontPatcher.zip
# The zip was fetched unverified until KIT-275. All five families pin the same
# URL, so Nix collapses them to a single store path — but only if the hash
# matches too, which makes this line the thing that keeps them collapsed.
NERD_FONTS_PATCHER_SHA256=a8f11e511ed7c69e96680858c06b50a643ea7752e26d5cd13dd5e5cc53ab1760
# digest of nerdfonts/patcher:latest as of KIT-236 work (2026-07)

# Half-width symbol donor. Sarasa *Mono* draws EAW-neutral symbols (⏵ ✓ ⌘ …)
# at 2-cell advance; terminals give them 1 cell, so the ink overflows. Sarasa
# *Term* ships properly designed 1-cell versions of the same shapes, which
# 06-narrow-symbols.sh transplants. Same upstream tag/UPM as SARASA_REF.
SARASA_TERM_ARCHIVE_URL=https://github.com/be5invis/Sarasa-Gothic/releases/download/v1.0.40/SarasaTermSlabSC-TTF-Unhinted-1.0.40.7z
# Was fetched unverified until KIT-275.
SARASA_TERM_ARCHIVE_SHA256=d809a92d89c912942f19cdbc56fd3a7df982c9a653ac846e8e5bfc72edafb903
SARASA_TERM_REGULAR=SarasaTermSlabSC-Regular.ttf
SARASA_TERM_BOLD=SarasaTermSlabSC-Bold.ttf
