# Pinned inputs for Fusion Pixel 12px Mono + hand-drawn programming ligatures + Nerd Font Mono
# Change deliberately; record why in the commit.

# --- Fusion Pixel Font (12px monospaced TTF release) -------------------------
# https://github.com/TakWolf/fusion-pixel-font/releases
FUSION_REPO=https://github.com/TakWolf/fusion-pixel-font
FUSION_RELEASE_TAG=2026.07.20
FUSION_ZIP_URL='https://github.com/TakWolf/fusion-pixel-font/releases/download/2026.07.20/fusion-pixel-font-12px-monospaced-ttf-v2026.07.20.zip'
FUSION_ZIP_SHA256=d751204e62248ed3acd9508b6a68f1e731b1aa86114d25ad92880b145a7e6685
# Language flavor for the product face (zh_hans covers CJK SC + Latin)
FUSION_TTF=fusion-pixel-12px-monospaced-zh_hans.ttf
FUSION_FONT_SIZE=12
# Half-width donor for EAW=Ambiguous punctuation. zh_hans draws “ ” ‘ ’ … · ‥ ․ ‧
# at 2 cells with the ink in the right half; terminals give Ambiguous codepoints
# 1 cell, so the ink overflows onto the next character. The latin flavor of the
# same release draws the same nine at 1 cell on the same grid —
# 03-narrow-ambiguous.sh transplants those. Same zip as FUSION_TTF.
FUSION_TTF_HALFWIDTH_DONOR=fusion-pixel-12px-monospaced-latin.ttf

# --- Product metrics (match Fusion 12px mono) --------------------------------
# 1 pixel = 100 font units; half cell = 6px = 600; full CJK = 12px = 1200
EN_ADV=600
CJK_ADV=1200
UPM=1200
PX_UNIT=100
PIXEL_H=12
HHEA_ASCENT=1000
HHEA_DESCENT=-200

# --- Product naming ----------------------------------------------------------
# Recipe: FusionPixel12 + NFM (Nerd Font Mono), same style as SarasaNZSSlab NFM
# Windows name ID 1 ≤ 31 chars ("FusionPixel12 NFM" = 17).
FAMILY_NAME='FusionPixel12 NFM'
FAMILY_PS=FusionPixel12NFM
PRODUCT_STEM=FusionPixel12NFM
# Intermediate (pre-Nerd) family after ligature inject
BASE_FAMILY_NAME='FusionPixel12 Mono'
BASE_FAMILY_PS=FusionPixel12Mono

# --- Nerd Fonts patcher ------------------------------------------------------
# https://github.com/ryanoasis/nerd-fonts/releases
# Nerd glyphs are patched as-is (no pixel redraw).
NERD_FONTS_TAG=v3.4.0
NERD_FONTS_PATCHER_URL=https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/FontPatcher.zip
# The zip was fetched unverified until KIT-275. All five families pin the same
# URL, so Nix collapses them to a single store path — but only if the hash
# matches too, which makes this line the thing that keeps them collapsed.
NERD_FONTS_PATCHER_SHA256=a8f11e511ed7c69e96680858c06b50a643ea7752e26d5cd13dd5e5cc53ab1760
