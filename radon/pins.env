# Pinned inputs for RadonWenKai Dual / NFM
# Monaspace Radon (Latin, coding ligatures via calt/dlig) + 霞鹜文楷 (CJK)
# Reproducible build: change deliberately; record why in the commit.

# --- Monaspace Radon (Frozen TrueType; texture healing baked in) ------------
# https://github.com/githubnext/monaspace/releases/tag/v1.400
# Frozen TTFs keep calt/dlig coding ligatures as TrueType (static OTFs are CFF).
MONASPACE_REPO=https://github.com/githubnext/monaspace
MONASPACE_TAG=v1.400
MONASPACE_FROZEN_ZIP_URL=https://github.com/githubnext/monaspace/releases/download/v1.400/monaspace-frozen-v1.400.zip
MONASPACE_FROZEN_ZIP_SHA256=f4a846421d1d6bb1233e5cb748d2afb85c7111b3da994a200504eaffd97a3a05
# Paths inside the zip
RADON_TTF_REGULAR='Frozen Fonts/Monaspace Radon/MonaspaceRadonFrozen-Regular.ttf'
RADON_TTF_BOLD='Frozen Fonts/Monaspace Radon/MonaspaceRadonFrozen-Bold.ttf'
# Native mono cell before UPM normalize (UPM 2000 → advance 1240)
RADON_SRC_UPM=2000
RADON_SRC_ADV=1240
# post.italicAngle on MonaspaceRadonFrozen-Italic (right-leaning)
RADON_ITALIC_ANGLE_DEG=-11

# --- 霞鹜文楷 LXGW WenKai ---------------------------------------------------
# https://github.com/lxgw/LxgwWenKai/releases/tag/v1.522
# Weight pairing (same idea as LXGW Bright Code × Monaspace):
#   product Regular ← Radon Regular + WenKai Medium (closer stem match)
#   product Bold    ← Radon Bold    + WenKai Medium (heaviest WenKai) + embolden
WENKAI_REPO=https://github.com/lxgw/LxgwWenKai
WENKAI_TAG=v1.522
WENKAI_TTF_MEDIUM_URL=https://github.com/lxgw/LxgwWenKai/releases/download/v1.522/LXGWWenKai-Medium.ttf
WENKAI_TTF_MEDIUM_SHA256=d4bdeb38a39151d74d084cba5090f8cb7d20bf83eedb78c35939ae70b9f4e3f6
# Optional Regular (kept for A/B; default product uses Medium)
WENKAI_TTF_REGULAR_URL=https://github.com/lxgw/LxgwWenKai/releases/download/v1.522/LXGWWenKai-Regular.ttf
WENKAI_TTF_REGULAR_SHA256=39ad71264b588165b469e35e6afb162a378dacd1f95348160240ba9038ac3009

# --- Product metrics (UPM 1000) ---------------------------------------------
# After scale_upem(Radon, 1000): EN advance = 620. Keep it (no X-crush).
# CJK cell = 2 × EN = 1240 (outline unscaled; advance expanded & centred).
TARGET_UPM=1000
EN_ADV=620
CJK_ADV=1240

# --- CJK optical match (measured via tools/measure_stroke_width.py) ---------
# At UPM 1000, scanline stroke_median:
#   Radon Regular Latin ≈ 90.7   WenKai Medium ≈ 74.8   (raw gap ~16)
#   Radon Bold    Latin ≈ 130.5  WenKai Medium ≈ 74.8   (raw gap ~56)
# Embolden strengths (pathops stroke) calibrated on sample glyphs then applied
# full-font. Re-run: ./scripts/calibrate-stroke.sh
CJK_EMBOLDEN_REGULAR=12
CJK_EMBOLDEN_BOLD=48

# Mild pseudo-oblique for CJK so it rides with Radon's handwriting lean.
# Full Radon Italic is −11°; "slightly" → ~8° for upright product styles.
CJK_OBLIQUE_DEG=8

# --- Product naming ---------------------------------------------------------
# Radon   = Monaspace Radon (Latin / programming + coding ligatures)
# WenKai  = 霞鹜文楷 (CJK)
# Dual    = dual-width 2:1 base product
# NFM     = Nerd Font Mono (single-width icons, CJK stays 2-cell)
FAMILY_NAME='RadonWenKai Dual'
FAMILY_PS=RadonWenKaiDual
PRODUCT_STEM=RadonWenKaiDual
NERD_FONT_FAMILY='RadonWenKai NFM'
NERD_FONT_FAMILY_PS=RadonWenKaiNFM

# --- Vertical metrics (blend; coding-oriented, UPM 1000) --------------------
# Derived from half of Monaspace hhea (1890/-400/200 @2000) with a touch of
# WenKai win descent headroom.
HHEA_ASCENT=945
HHEA_DESCENT=-200
HHEA_LINE_GAP=100
OS2_TYPO_ASCENDER=945
OS2_TYPO_DESCENDER=-200
OS2_TYPO_LINE_GAP=100
OS2_WIN_ASCENT=980
OS2_WIN_DESCENT=250

# --- Nerd Fonts patcher -----------------------------------------------------
NERD_FONTS_TAG=v3.4.0
NERD_FONTS_PATCHER_URL=https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/FontPatcher.zip
NERD_FONTS_DOCKER_IMAGE=nerdfonts/patcher@sha256:4e820b4e5484447abaa6499a1a7448b83d0b8ca63cfe71df9f594336025a504a
# auto | docker | fontforge
NERD_PATCH_METHOD=auto
