# Pinned upstream inputs for CourierPrimeZhuque NFM
# (Courier Prime Latin slab mono + Zhuque Fangsong CJK + Nerd Font Mono, dual-width)
# Reproducible build: change these deliberately; record why in the commit.

# --- Courier Prime (Latin / slab mono) --------------------------------------
# Source: https://github.com/quoteunquoteapps/CourierPrime
# Slab-serif monospaced Courier revival (NOT Courier Prime Code / Sans).
# Font version inside TTF: Version 3.018 (name ID 5)
# No release tags; pin by commit SHA of master at pin time.
COURIER_PRIME_REPO=https://github.com/quoteunquoteapps/CourierPrime
COURIER_PRIME_COMMIT=7fd585a2dd4c1612c79b3308e300923d1c13df93
COURIER_PRIME_TTF_REGULAR_URL="https://raw.githubusercontent.com/quoteunquoteapps/CourierPrime/${COURIER_PRIME_COMMIT}/fonts/ttf/CourierPrime-Regular.ttf"
COURIER_PRIME_TTF_BOLD_URL="https://raw.githubusercontent.com/quoteunquoteapps/CourierPrime/${COURIER_PRIME_COMMIT}/fonts/ttf/CourierPrime-Bold.ttf"
COURIER_PRIME_TTF_REGULAR_SHA256=72f793376f8e2841656bf21d77a5de010f2929bd6956a22ee848ad0c7eb978af
COURIER_PRIME_TTF_BOLD_SHA256=ff1f38786c849d1c41fa8e447960abdb2bd75fdfb0cfcdeb524fad65a5af3638
# Upstream UPM 2048 mono cell 1228 → scale_upem(1000) → EN_SRC 600
COURIER_PRIME_SRC_UPM=2048
COURIER_PRIME_SRC_ADV=1228
# After UPM normalize to 1000 (merge step)
LATIN_SRC_ADV=600
LATIN_TARGET_UPM=1000

# --- Zhuque Fangsong 朱雀仿宋 (CJK) ----------------------------------------
# Release: https://github.com/TrionesType/zhuque/releases/tag/v0.212
# Technical preview, single Regular weight (OFL). Drop embedded Alegreya Latin.
ZHUQUE_REPO=https://github.com/TrionesType/zhuque
ZHUQUE_RELEASE_TAG=v0.212
ZHUQUE_ZIP_URL='https://github.com/TrionesType/zhuque/releases/download/v0.212/ZhuqueFangsong-v0.212.zip'
ZHUQUE_ZIP_SHA256=bb8b661a7643d2296a72d9d10530a00949419c4e527fb61783f73c2ba1a8c062
ZHUQUE_TTF_IN_ZIP=ZhuqueFangsong-Regular.ttf
# Stem-measured embolden (scanline vertical median vs Courier Prime at UPM 1000).
# Metric: vertical-stem median on Latin IHMNltf vs Han 中一十日国木工的是不
# (serif/tools/measure_stroke_width + handwriting calibrate_cjk_weight).
#   Prime Regular v≈73 → Zhuque needs strength 8  (raw Zhuque v≈57)
#   Prime Bold    v≈122 → Zhuque needs strength 32
CJK_EMBOLDEN_REGULAR=8
CJK_EMBOLDEN_BOLD=32

# --- Product metrics --------------------------------------------------------
# EN 600 / CJK 1200 = strict 2:1 after Prime UPM 2048→1000 (native EN≈600).
EN_ADV=600
CJK_ADV=1200
UPM=1000

# --- Product naming ---------------------------------------------------------
# Source-token recipe (full inheritance, same style as LilexSansSC NFM):
#   CourierPrime = Courier Prime (Latin slab mono)
#   Zhuque       = 朱雀仿宋 Zhuque Fangsong (CJK)
#   Dual         = pre-Nerd intermediate
#   NFM          = Nerd Font Mono product
# Windows name ID 1 must stay ≤ 31 chars ("CourierPrimeZhuque NFM" = 22).
BASE_FAMILY_NAME='CourierPrimeZhuque Dual'
BASE_FAMILY_PS=CourierPrimeZhuqueDual
FAMILY_NAME='CourierPrimeZhuque NFM'
FAMILY_PS=CourierPrimeZhuqueNFM
PRODUCT_STEM=CourierPrimeZhuqueNFM
FAMILY_SUFFIX=

# --- Vertical metrics (coding-oriented; cover Zhuque bbox) ------------------
HHEA_ASCENT=1050
HHEA_DESCENT=-300
HHEA_LINE_GAP=0
OS2_TYPO_ASCENDER=880
OS2_TYPO_DESCENDER=-220
OS2_TYPO_LINE_GAP=0
OS2_WIN_ASCENT=1100
OS2_WIN_DESCENT=320

# --- Nerd Fonts patcher ------------------------------------------------------
# Same pin as sans/ / serif/ / pixel/ for a consistent icon set.
NERD_FONTS_TAG=v3.4.0
NERD_FONTS_PATCHER_URL=https://github.com/ryanoasis/nerd-fonts/releases/download/v3.4.0/FontPatcher.zip
NERD_FONTS_DOCKER_IMAGE=nerdfonts/patcher@sha256:4e820b4e5484447abaa6499a1a7448b83d0b8ca63cfe71df9f594336025a504a
# auto | docker | fontforge
NERD_PATCH_METHOD=auto
