---
// The plate: one family's glyphs set large inside a ruled frame, with the 2:1
// cells drawn behind them on coding faces. Used wherever a page shows a family
// as an image rather than as text about it.

import type { Family } from '../data/families'
import { cssFamily, hasFonts } from '../data/fonts'

interface Props {
  family: Family
  /** What to set. Defaults to the house pair: two CJK cells, two Latin half-cells. */
  text?: string
  /** Overrides the scale step; Pixel snaps to whole multiples of 12px anyway. */
  size?: string
  /** Left / right of the caption rule. */
  caption?: [string, string]
  /** Left / right of the foot rule; omitted when absent. */
  foot?: [string, string]
  tag?: 'div' | 'a'
  href?: string
}

const { family, text = '永安Ag', size, caption, foot, tag = 'div', href } = Astro.props

// One Latin cell in em, measured from the released fonts (advance of `A` over
// units per em). Everything not listed is 500 / 1000.
const CELL_EM: Record<string, string> = { sans: '0.55em', type: '0.6em' }

const proportional = family.id === 'hand-text'
const pixel = family.id === 'pixel'

const style = [
  hasFonts ? `font-family:"${cssFamily(family.id)}", ui-monospace, monospace` : '',
  proportional ? '--cells:none' : '',
  CELL_EM[family.id] ? `--cell-w:${CELL_EM[family.id]}` : '',
  !pixel && size ? `font-size:${size}` : '',
].filter(Boolean).join(';')

const Tag = tag
---

<Tag class:list={['plate', { 'plate--link': tag === 'a' }]} href={href}>
  {caption && (
    <div class="plate__caption">
      <span class="label"><b>{caption[0]}</b></span>
      <span class="label">{caption[1]}</span>
    </div>
  )}
  <p class:list={['plate__glyphs', { 'is-pixel': pixel }]} style={style} aria-hidden="true"><span>{text}</span></p>
  {foot && (
    <div class="plate__foot">
      <span class="label">{foot[0]}</span>
      <span class="label">{foot[1]}</span>
    </div>
  )}
</Tag>

<style>
  .plate--link {
    display: block;
    text-decoration: none;
  }

  /* Whole multiples of the 12px bitmap only. */
  .plate__glyphs.is-pixel {
    font-size: 96px;
  }

  @media (min-width: 560px) {
    .plate__glyphs.is-pixel {
      font-size: 168px;
    }
  }

  @media (min-width: 1100px) {
    .plate__glyphs.is-pixel {
      font-size: 324px;
    }
  }

  .plate--link:hover .plate__glyphs {
    color: var(--accent);
  }
</style>
