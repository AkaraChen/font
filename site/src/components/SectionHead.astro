---
// A numbered section head on the folio: number and label in the margin, the
// heading in the body, a full-width ink rule above both.

interface Props {
  /** Two-digit section number, e.g. "01". */
  n: string
  label: string
  /** Omit when the label already says everything. */
  title?: string
}

const { n, label, title } = Astro.props
// A label that only repeats the heading is left out; the number stands alone.
const marginLabel = label === title ? '' : label
---

<header class:list={['folio', 'section-head', { 'section-head--bare': !title }]}>
  <span class="folio__margin label"><span class="num">{n}</span>{marginLabel}</span>
  {title ? <h2 class="folio__body">{title}</h2> : <span class="folio__body" />}
  <slot />
</header>
