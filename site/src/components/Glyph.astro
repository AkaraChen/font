---
// One character standing in a 米字格: the calligrapher's practice square, with
// its centre line doubling as the 2:1 split of a coding cell. This is how the
// site introduces every family.

import { cellEm, faceStyle, isPixel } from '../data/specimen'

interface Props {
  /** Family id whose face sets the character. */
  family: string
  char: string
  /** CSS length for one em; the square is exactly this size. */
  size?: string
  /** Draw the grid. */
  grid?: boolean
  class?: string
}

const { family, char, size = '1em', grid = true, class: className } = Astro.props
const pixel = isPixel(family)
// The square is one CJK cell: two Latin cells wide, so 1.2em on Type, 1.1em on Sans.
const width = 2 * (cellEm[family] ?? 0.5)
---

<span
  class:list={['mi', className, { 'is-pixel': pixel, 'mi--pixel': pixel }]}
  style={faceStyle(family, `--mi:${size};--mi-w:${width}`)}
  aria-hidden="true"
>
  {grid && (
    <svg class="mi__grid" viewBox="0 0 100 100" preserveAspectRatio="none">
      <rect x="0.25" y="0.25" width="99.5" height="99.5" />
      <path class="mi__dash" d="M50 0V100M0 50H100M0 0L100 100M100 0L0 100" />
    </svg>
  )}
  <span class="mi__char">{char}</span>
</span>

<style>
  .mi {
    position: relative;
    display: inline-block;
    width: calc(var(--mi) * var(--mi-w, 1));
    height: var(--mi);
    font-size: var(--mi);
    line-height: 1;
    flex: none;
  }

  .mi__grid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--seal);
    stroke-width: 1px;
    vector-effect: non-scaling-stroke;
    overflow: visible;
  }

  .mi__grid rect,
  .mi__grid path {
    vector-effect: non-scaling-stroke;
  }

  .mi__dash {
    stroke-dasharray: 4 5;
    opacity: 0.55;
  }

  .mi__char {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    line-height: 1;
    /* With line-height 1 the faces here sit their ideographic box a little
       above the em square; this settles it back in. */
    transform: translateY(0.05em);
  }

  /* The bitmap face sits higher in its em box than the outline faces. */
  .mi--pixel .mi__char {
    transform: translateY(-0.05em);
  }
</style>
