---
// The specimen rows on the home page. Each sample is rendered in its own
// subsetted face, so the strip costs a few hundred KB in total rather than the
// ~60 MB the full fonts would.

import { families } from '../data/families'
import { cssFamily, hasFonts } from '../data/fonts'
import { localePath, type Locale } from '../i18n/ui'

/** Drops version pins and secondary names so the caption stays one short line. */
function shortName(value: string): string {
  return value.split('·')[0]!.replace(/\s+v?\d[\d.]*(\s|$)/i, ' ').replace(/\s*\(.*?\)/, '').trim()
}

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<div class="specimen">
  {families.map(family => (
    <a class="specimen__row" href={localePath(locale, `/family/${family.id}`)}>
      <span class="specimen__name">
        {family.name[locale]}
        <em>{shortName(family.latin)} × {shortName(family.cjk)}</em>
      </span>
      <span
        class="specimen__sample"
        style={hasFonts ? `font-family:"${cssFamily(family.id)}", ui-monospace, monospace` : undefined}
      >{family.sample}</span>
      <span class="specimen__meta">{family.weights.map(weight => weight[0]).join(' · ')}</span>
    </a>
  ))}
</div>

<style>
  .specimen {
    border-top: 1px solid var(--rule);
  }

  .specimen__row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) 60px;
    gap: 24px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--rule-soft);
    text-decoration: none;
  }

  .specimen__row:hover {
    background: var(--rule-soft);
  }

  .specimen__name {
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 700;
  }

  .specimen__name em {
    display: block;
    font-style: normal;
    font-weight: 400;
    font-size: 11px;
    color: var(--ink-faint);
    margin-top: 4px;
  }

  .specimen__sample {
    font-size: clamp(18px, 2.2vw, 26px);
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .specimen__meta {
    font-family: var(--font-display);
    font-size: 11px;
    color: var(--ink-faint);
    text-align: right;
  }

  @media (max-width: 840px) {
    .specimen__row {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .specimen__meta {
      text-align: left;
    }
  }
</style>
