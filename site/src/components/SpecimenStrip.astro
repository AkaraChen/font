---
// The specimen rows on the home and families pages. Each sample is rendered in
// its own subsetted face, so the strip costs a few hundred KB in total rather
// than the ~60 MB the full fonts would.
//
// Every row sits on the folio: number and facts in the margin, the family's
// own glyphs in the body — first the house pair large, then its sample line.

import { families } from '../data/families'
import { cssFamily, hasFonts } from '../data/fonts'
import { localePath, type Locale } from '../i18n/ui'

/** Drops version pins and secondary names so the caption stays one short line. */
function shortName(value: string): string {
  return value.split('·')[0]!.replace(/\s+v?\d[\d.]*(\s|$)/i, ' ').replace(/\s*\(.*?\)/, '').trim()
}

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<ol class="specimen">
  {families.map((family, index) => (
    <li>
      <a class="folio specimen__row" href={localePath(locale, `/family/${family.id}`)}>
        <span class="folio__margin specimen__facts">
          <span class="label"><span class="num">{String(index + 1).padStart(2, '0')}</span></span>
          <span class="specimen__name">{family.name[locale]}</span>
          <span class="label">{shortName(family.latin)} × {shortName(family.cjk)}</span>
          <span class="label">{family.grid} · {family.weights.join(' / ')}</span>
        </span>
        <span
          class:list={['folio__body', 'specimen__type', { 'is-pixel': family.id === 'pixel' }]}
          style={hasFonts ? `font-family:"${cssFamily(family.id)}", ui-monospace, monospace` : undefined}
        >
          <span class="specimen__pair" aria-hidden="true">永安Ag</span>
          <span class="specimen__sample">{family.sample}</span>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .specimen {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--rule);
  }

  .specimen__row {
    padding-block: var(--s-3) var(--s-3);
    border-top: 1px solid var(--rule);
    text-decoration: none;
    align-items: start;
  }

  .specimen__facts {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding-top: 6px;
  }

  .specimen__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.3;
    margin: 6px 0 6px;
  }

  .specimen__type {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .specimen__pair {
    font-size: 72px;
    line-height: 1.15;
    letter-spacing: 0;
    transition: color 0.15s;
  }

  .specimen__sample {
    font-size: 22px;
    line-height: 1.6;
    color: var(--ink-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .specimen__type.is-pixel .specimen__sample {
    font-size: 24px;
  }

  .specimen__row:hover .specimen__pair {
    color: var(--accent);
  }

  .specimen__row:hover .specimen__name {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 860px) {
    .specimen__row {
      row-gap: var(--s-1);
    }

    .specimen__facts {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 12px;
      padding-top: 0;
    }

    .specimen__facts > :first-child {
      grid-row: span 3;
      padding-top: 8px;
    }

    .specimen__name {
      margin: 0;
    }

    .specimen__pair {
      font-size: 60px;
    }

    .specimen__type.is-pixel .specimen__pair {
      font-size: 60px;
    }

    .specimen__sample {
      font-size: 17px;
    }
  }
</style>
