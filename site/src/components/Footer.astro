---
import { manifest } from '../data/fonts'
import { upstreams } from '../data/upstreams'
import { localePath, useTranslations, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const colophon = [
  { role: t('footer.set.display'), name: 'AKR Slab', font: 'var(--font-display)' },
  { role: t('footer.set.text'), name: 'AKR Hand Text', font: 'var(--font-text)' },
  { role: t('footer.set.label'), name: 'AKR Sans', font: 'var(--font-label)' },
]
---

<footer class="band band--ink footer">
  <div class="wrap footer__grid">
    <div>
      <span class="label">{t('footer.colophon')}</span>
      <dl class="footer__colophon">
        {colophon.map(item => (
          <div>
            <dt class="label">{item.role}</dt>
            <dd style={`font-family:${item.font}`}>{item.name}</dd>
          </div>
        ))}
      </dl>
    </div>
    <div class="footer__notes">
      <p>{t('footer.derived')}</p>
      <p class="footer__credits">
        <span class="label">{locale === 'zh' ? '上游致谢' : 'Upstream credits'}</span>
        {upstreams.map((upstream, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a href={upstream.url} rel="noopener">{upstream.name[locale]}</a>
          </>
        ))}
      </p>
      <p class="label footer__meta">
        {manifest.tag && (
          <>
            <a href={manifest.releaseUrl} rel="noopener">{t('common.release')} {manifest.tag}</a>
            <span aria-hidden="true"> · </span>
          </>
        )}
        <a href={localePath(locale, '/license')}>{t('nav.license')}</a>
        <span aria-hidden="true"> · </span>
        <a href="https://github.com/AkaraChen/font" rel="noopener">GitHub</a>
      </p>
    </div>
  </div>
  <p class="footer__mark" aria-hidden="true">AKR 字体</p>
</footer>

<style>
  .footer {
    padding-bottom: 0;
    overflow: hidden;
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
  }

  .footer__colophon {
    margin: 16px 0 0;
  }

  .footer__colophon div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule);
  }

  .footer__colophon dd {
    margin: 0;
    font-size: 24px;
    line-height: 1.2;
  }

  .footer__notes {
    color: var(--fg-2);
    font-size: 15px;
  }

  .footer__credits {
    line-height: 2;
  }

  .footer__credits .label {
    display: inline;
    margin-right: 10px;
  }

  .footer a {
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--seal);
  }

  /* The wordmark, set so large it runs off the bottom of the page. */
  .footer__mark {
    margin: clamp(48px, 8vw, 96px) 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(88px, 21vw, 300px);
    line-height: 0.74;
    letter-spacing: -0.04em;
    white-space: nowrap;
    text-align: center;
    color: var(--paper);
  }

  @media (max-width: 860px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
