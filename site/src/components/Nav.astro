---
import { localePath, otherLocale, useTranslations, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  /** Unprefixed path of the current page, so the language switch stays put. */
  path: string
}

const { locale, path } = Astro.props
const t = useTranslations(locale)
const other = otherLocale(locale)

const links = [
  { href: '/families', label: t('nav.families') },
  { href: '/preview', label: t('nav.preview') },
  { href: '/upstream', label: t('nav.upstream') },
  { href: '/blog', label: t('nav.blog') },
  { href: '/license', label: t('nav.license') },
]
---

<header class="nav">
  <div class="wrap nav__inner">
    <a class="nav__logo" href={localePath(locale, '/')}>
      <span class="nav__seal" aria-hidden="true">字</span>
      <span>AKR {locale === 'zh' ? '字体' : 'Fonts'}</span>
    </a>
    <nav class="nav__links" aria-label={locale === 'zh' ? '主导航' : 'Main'}>
      {links.map(link => (
        <a href={localePath(locale, link.href)} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a href="https://github.com/AkaraChen/font" rel="noopener">GitHub</a>
    </nav>
    <a class="nav__lang" href={localePath(other, path)} lang={other === 'zh' ? 'zh-Hans' : 'en'}>
      {t('common.otherLang')}
    </a>
  </div>
</header>

<style>
  .nav {
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
    position: relative;
    z-index: 2;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: 64px;
  }

  .nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    line-height: 1;
    text-decoration: none;
    margin-right: auto;
  }

  /* The seal: a vermilion square with one character, as a printer would sign. */
  .nav__seal {
    display: inline-grid;
    place-items: center;
    width: 30px;
    height: 30px;
    background: var(--seal);
    color: var(--paper);
    font-size: 19px;
    line-height: 1;
  }

  .nav__links {
    display: flex;
    gap: 26px;
    flex-wrap: wrap;
  }

  .nav__links a,
  .nav__lang {
    font-family: var(--font-label);
    font-size: var(--t-s);
    line-height: 1;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 6px;
  }

  .nav__links a:hover,
  .nav__lang:hover {
    color: var(--seal);
  }

  .nav__links a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--seal);
  }

  .nav__lang {
    padding-left: 26px;
    border-left: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .nav__inner {
      flex-wrap: wrap;
      gap: 0 20px;
      padding-block: 14px 0;
    }

    .nav__links {
      order: 3;
      width: 100%;
      min-width: 0;
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 20px;
      margin-top: 12px;
      padding-block: 10px;
      border-top: 1px solid var(--line);
      scrollbar-width: none;
    }

    .nav__links a {
      white-space: nowrap;
    }

    .nav__lang {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
