---
import { localePath, otherLocale, useTranslations, type Locale } from '../i18n/ui'

interface Props {
  locale: Locale
  /** Unprefixed path of the current page, so the language switch stays put. */
  path: string
}

const { locale, path } = Astro.props
const t = useTranslations(locale)
const other = otherLocale(locale)

const links = [
  { href: '/families', label: t('nav.families') },
  { href: '/preview', label: t('nav.preview') },
  { href: '/upstream', label: t('nav.upstream') },
  { href: '/blog', label: t('nav.blog') },
  { href: '/license', label: t('nav.license') },
]
---

<header class="nav">
  <div class="page nav__inner">
    <a class="nav__logo" href={localePath(locale, '/')}>AKR {locale === 'zh' ? '字体' : 'Fonts'}</a>
    <nav class="nav__links" aria-label={locale === 'zh' ? '主导航' : 'Main'}>
      {links.map(link => (
        <a href={localePath(locale, link.href)} aria-current={path.startsWith(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a href="https://github.com/AkaraChen/font" rel="noopener">GitHub</a>
    </nav>
    <a class="nav__lang" href={localePath(other, path)} lang={other === 'zh' ? 'zh-Hans' : 'en'}>
      {t('common.otherLang')}
    </a>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--ink);
  }

  .nav__inner {
    display: flex;
    align-items: baseline;
    gap: var(--s-3);
    padding-block: 22px 18px;
  }

  .nav__logo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 20px;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
    margin-right: auto;
  }

  .nav__links {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
  }

  .nav__links a,
  .nav__lang {
    font-family: var(--font-label);
    font-size: var(--t-meta);
    line-height: 1;
    color: var(--ink-muted);
    text-decoration: none;
    padding-bottom: 4px;
    border-bottom: 1px solid transparent;
  }

  .nav__links a:hover,
  .nav__lang:hover {
    color: var(--ink);
  }

  .nav__links a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  .nav__lang {
    padding-left: var(--s-3);
    border-left: 1px solid var(--rule);
  }

  @media (max-width: 860px) {
    .nav__inner {
      flex-wrap: wrap;
      row-gap: var(--s-2);
      padding-block: 18px 14px;
    }

    .nav__links {
      order: 3;
      width: 100%;
      gap: 6px 18px;
      padding-top: 12px;
      border-top: 1px solid var(--rule-soft);
    }

    .nav__lang {
      padding-left: 0;
      border-left: 0;
    }
  }
</style>
