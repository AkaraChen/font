---
import { families } from '../../data/families'
import { manifest } from '../../data/fonts'
import { upstreams } from '../../data/upstreams'
import { localePath, useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'
import Plate from '../Plate.astro'
import SectionHead from '../SectionHead.astro'
import SpecimenStrip from '../SpecimenStrip.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const hero = families.find(family => family.id === 'hand')!

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': t('site.title'),
  'url': Astro.site?.href,
  'applicationCategory': 'DesignApplication',
  'operatingSystem': 'Windows, macOS, Linux',
  'description': t('site.description'),
  'license': 'https://scripts.sil.org/OFL',
  'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
  'author': {
    '@type': 'Person',
    'name': 'AkaraChen',
    'url': 'https://github.com/AkaraChen',
    'sameAs': ['https://github.com/AkaraChen'],
  },
  'softwareVersion': manifest.tag || undefined,
  'downloadUrl': manifest.releaseUrl,
  'codeRepository': `https://github.com/${manifest.repo}`,
  'isAccessibleForFree': true,
}
---

<Base locale={locale} title={t('site.title')} description={t('site.description')} path="/" jsonLd={jsonLd}>
  <section class="page">
    <header class="folio page-head hero">
      <ul class="folio__margin hero__marks">
        {t('home.eyebrow').split(' · ').map(mark => <li class="label">{mark}</li>)}
      </ul>
      <div class="folio__body">
        <h1>{t('home.heading')}</h1>
        <p class="lead">{t('home.intro')}</p>
        <div class="actions">
          <a class="button" href={manifest.releaseUrl} rel="noopener">{t('home.cta.download')}{manifest.tag && <span class="hero__tag">{manifest.tag}</span>}</a>
          <a class="button button--ghost" href={localePath(locale, '/preview')}>{t('home.cta.preview')}</a>
        </div>
      </div>
    </header>

    <Plate
      family={hero}
      caption={[hero.product, `${t('family.grid')} ${hero.grid}`]}
      foot={[`${hero.latin.split(' v')[0]} × ${hero.cjk.split(' v')[0]}`, t('home.specimen.note')]}
    />
  </section>

  <section class="page section section--first">
    <SectionHead n="01" label={t('home.specimen')} title={t('home.families.heading')}>
      <p class="folio__body lead">{t('home.specimen.note')}</p>
    </SectionHead>
    <SpecimenStrip locale={locale} />
  </section>

  <section class="page section">
    <SectionHead n="02" label={t('nav.preview')} title={t('preview.title')} />
    <div class="folio">
      <div class="folio__body">
        <p class="lead">{t('preview.intro')}</p>
        <a class="button button--ghost" href={localePath(locale, '/preview')}>{t('nav.preview')} →</a>
      </div>
    </div>
  </section>

  <section class="page section">
    <SectionHead n="03" label={t('upstream.title')} title={t('home.upstream.heading')} />
    <div class="folio">
      <div class="folio__body">
        <p class="lead">{t('home.upstream.intro')}</p>
        <ul class="upstreams">
          {upstreams.map(upstream => (
            <li>
              <a href={localePath(locale, `/upstream/${upstream.slug}`)}>
                <strong>{upstream.name[locale]}</strong>
                <span class="label">{upstream.families.map(id => families.find(f => f.id === id)?.name[locale]).filter(Boolean).join(' · ')}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="page section">
    <SectionHead n="04" label={t('home.why.heading')} />
    <div class="folio">
      <p class="folio__body why">{t('home.why.body')}</p>
    </div>
  </section>
</Base>

<style>
  .hero__marks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .hero__marks li {
    padding-block: 6px;
    border-bottom: 1px solid var(--rule-soft);
  }

  .hero__marks li:first-child {
    color: var(--ink);
  }

  .hero .lead {
    margin-block: var(--s-3) var(--s-4);
  }

  .hero__tag {
    opacity: 0.6;
  }

  .section--first {
    padding-top: var(--s-6);
  }

  .upstreams {
    list-style: none;
    padding: 0;
    margin: var(--s-4) 0 0;
    columns: 2;
    column-gap: var(--s-4);
    border-top: 1px solid var(--rule);
  }

  .upstreams li {
    break-inside: avoid;
    border-bottom: 1px solid var(--rule-soft);
  }

  .upstreams a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-2);
    padding-block: 14px;
    text-decoration: none;
  }

  .upstreams strong {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 700;
  }

  .upstreams .label {
    text-align: right;
    letter-spacing: 0.06em;
  }

  .upstreams a:hover strong {
    color: var(--accent);
  }

  .why {
    font-family: var(--font-text);
    font-size: clamp(21px, 2.2vw, 28px);
    line-height: 1.7;
    max-width: 30em;
    margin: 0;
  }

  @media (max-width: 860px) {
    .hero__marks {
      display: flex;
      flex-wrap: wrap;
      gap: 0 14px;
      margin-bottom: var(--s-2);
    }

    .hero__marks li {
      border: 0;
      padding: 0;
    }

    .upstreams {
      columns: 1;
    }
  }
</style>
