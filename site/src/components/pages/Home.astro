---
import { families } from '../../data/families'
import { cssFamily, hasFonts, manifest } from '../../data/fonts'
import { upstreams } from '../../data/upstreams'
import { localePath, useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'
import FamilyBand from '../FamilyBand.astro'
import Glyph from '../Glyph.astro'
import Head from '../Head.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const hero = families.find(family => family.id === 'hand')!

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  'name': t('site.title'),
  'url': Astro.site?.href,
  'applicationCategory': 'DesignApplication',
  'operatingSystem': 'Windows, macOS, Linux',
  'description': t('site.description'),
  'license': 'https://scripts.sil.org/OFL',
  'offers': { '@type': 'Offer', 'price': '0', 'priceCurrency': 'USD' },
  'author': {
    '@type': 'Person',
    'name': 'AkaraChen',
    'url': 'https://github.com/AkaraChen',
    'sameAs': ['https://github.com/AkaraChen'],
  },
  'softwareVersion': manifest.tag || undefined,
  'downloadUrl': manifest.releaseUrl,
  'codeRepository': `https://github.com/${manifest.repo}`,
  'isAccessibleForFree': true,
}
---

<Base locale={locale} title={t('site.title')} description={t('site.description')} path="/" jsonLd={jsonLd}>
  <section class="band band--ink hero">
    <div class="wrap hero__grid">
      <div class="hero__drawing">
        <Glyph family={hero.id} char="永" size="var(--hero)" />
        <Glyph family={hero.id} char="A" cells={1} size="var(--hero)" />
      </div>
      <div class="hero__title">
        {locale === 'zh'
          ? (
              <h1 class="tate" aria-label={t('home.heading')}>
                {t('home.heading.columns').split('|').map(column => <span aria-hidden="true">{column}</span>)}
              </h1>
            )
          : <h1>{t('home.heading')}</h1>}
      </div>
      <div class="hero__foot">
        <ul class="hero__marks">
          {t('home.eyebrow').split(' · ').map(mark => <li class="label">{mark}</li>)}
        </ul>
        <p class="lead">{t('home.intro')}</p>
        <div class="actions">
          <a class="button hero__download" href={manifest.releaseUrl} rel="noopener">{t('home.cta.download')}{manifest.tag && <span class="hero__tag">{manifest.tag}</span>}</a>
          <a class="button button--ghost" href={localePath(locale, '/preview')}>{t('home.cta.preview')}</a>
        </div>
        <p class="label hero__caption">永 + A · {hero.product} · {t('family.grid')} {hero.grid}</p>
      </div>
    </div>
  </section>

  <div id="families">
    {families.map((family, index) => (
      <FamilyBand
        locale={locale}
        family={family}
        index={index + 1}
        total={families.length}
        tone={index % 2 === 0 ? 'paper' : 'ink'}
        flip={index % 2 === 1}
      />
    ))}
  </div>

  <section class="band">
    <div class="wrap">
      <Head locale={locale} n={1} title={t('home.upstream.heading')}>
        <a class="label" href={localePath(locale, '/upstream')}>{t('upstream.title')} →</a>
      </Head>
      <p class="lead index__lead">{t('home.upstream.intro')}</p>
      <ul class="index">
        {upstreams.map(upstream => (
          <li>
            <a href={localePath(locale, `/upstream/${upstream.slug}`)}>
              <span class="index__name">{upstream.name[locale]}</span>
              <span class="index__dots" aria-hidden="true"></span>
              <span class="index__where">{upstream.families.map(id => families.find(f => f.id === id)?.name[locale]).filter(Boolean).join('、')}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--tint why">
    <div class="wrap why__grid">
      <Head locale={locale} n={2} title={t('home.why.heading')} />
      <p class="why__body">{t('home.why.body')}</p>
    </div>
  </section>

  <section class="band try">
    <div class="wrap try__grid">
      <div>
        <Head locale={locale} n={3} title={t('preview.title')} />
        <p class="lead">{t('preview.intro')}</p>
        <a class="button" href={localePath(locale, '/preview')}>{t('nav.preview')} →</a>
      </div>
      <a class="try__line" href={localePath(locale, '/preview')} aria-hidden="true" tabindex="-1">
        {families.slice(0, 4).map(family => (
          <span style={hasFonts ? `font-family:"${cssFamily(family.id)}", ui-monospace, monospace` : undefined}>宽度对齐 Ag</span>
        ))}
      </a>
    </div>
  </section>
</Base>

<style>
  .hero {
    --hero: min(calc(100svh - 320px), 31vw);
    padding-block: clamp(40px, 5vw, 72px);
    min-height: calc(100svh - 64px);
    display: flex;
    align-items: center;
  }

  .hero__grid {
    width: 100%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto auto;
    column-gap: clamp(32px, 5vw, 80px);
    row-gap: 40px;
  }

  /* 永 and A drawn side by side, dimensioned: the 2:1 grid, shown. */
  .hero__drawing {
    grid-row: 1 / 3;
    align-self: center;
    display: flex;
    align-items: flex-start;
    gap: clamp(20px, 3vw, 40px);
  }

  .hero__title {
    display: flex;
    justify-content: flex-end;
  }

  .hero h1 {
    font-size: clamp(36px, 4.4vw, 68px);
    line-height: 1.12;
    letter-spacing: 0;
  }

  /* Chinese title set vertically, one phrase per column, read right to left. */
  .hero h1:lang(zh) {
    letter-spacing: 0.06em;
    line-height: 1.25;
  }

  .hero h1:lang(zh) span {
    display: block;
    white-space: nowrap;
  }

  .hero h1:lang(zh) span:last-child {
    color: var(--mark);
  }

  .hero__foot {
    align-self: end;
  }

  .hero__marks {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 18px;
    padding: 0 0 14px;
    margin: 0 0 18px;
    border-bottom: 1px solid var(--rule);
  }

  .hero__marks li:first-child {
    color: var(--mark);
  }

  .hero .lead {
    font-size: var(--t-m);
    margin-bottom: 24px;
  }

  .hero__download {
    background: var(--mark);
    border-color: var(--mark);
    color: var(--on-mark);
  }

  .hero__download:hover {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--bg);
  }

  .hero__tag {
    opacity: 0.7;
  }

  .hero__caption {
    margin: 24px 0 0;
  }

  .index__lead {
    margin-bottom: 40px;
  }

  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    columns: 2;
    column-gap: clamp(32px, 5vw, 80px);
  }

  .index li {
    break-inside: avoid;
  }

  .index a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding-block: 10px;
    text-decoration: none;
  }

  .index__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 22px;
    white-space: nowrap;
  }

  /* Dot leaders, as in the index at the back of a book. */
  .index__dots {
    flex: 1;
    min-width: 24px;
    border-bottom: 2px dotted var(--rule-strong);
    transform: translateY(-5px);
  }

  .index__where {
    font-family: var(--font-label);
    font-size: var(--t-s);
    color: var(--fg-2);
    text-align: right;
  }

  .index a:hover .index__name {
    color: var(--mark);
  }

  .why__body {
    font-size: clamp(22px, 2.6vw, 34px);
    line-height: 1.65;
    max-width: 26em;
    margin: 0;
  }

  .try__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
  }

  .try__line {
    display: flex;
    flex-direction: column;
    font-size: clamp(30px, 4.4vw, 60px);
    line-height: 1.35;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
  }

  .try__line span:nth-child(odd) {
    color: var(--fg-mute);
  }

  .try__line:hover span {
    color: var(--mark);
  }

  @media (max-width: 860px) {
    .hero {
      --hero: min(38vw, 220px);
      min-height: 0;
    }

    .hero__grid {
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 16px;
    }

    .hero__drawing {
      grid-row: 1;
      gap: 14px;
    }

    .hero h1:lang(zh) {
      font-size: clamp(22px, 6.2vw, 40px);
    }

    .hero h1:lang(en) {
      grid-column: 1 / -1;
    }

    .hero__title:has(h1:lang(en)) {
      grid-column: 1 / -1;
      justify-content: flex-start;
    }

    .hero__foot {
      grid-column: 1 / -1;
    }

    .index {
      columns: 1;
    }

    .try__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
