---
import { useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'

import FontPreview from '../FontPreview.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const description = locale === 'zh'
  ? '在浏览器里预览 AKR 的八套中英混排编程字体：切换字体、字号、行高、连字与深浅主题，输入自己的代码实时看效果。'
  : 'Preview all eight AKR CJK coding fonts in the browser: switch family, size, line height, ligatures and theme, and type your own code.'
---

<Base locale={locale} title={t('preview.title')} description={description} path="/preview">
  <section class="band band--ink bench">
    <div class="wrap">
      <header class="bench__head">
        <h1>{t('preview.title')}</h1>
        <p class="lead">{t('preview.intro')}</p>
      </header>
      <FontPreview locale={locale} autoload syncUrl layout="bench" />
    </div>
  </section>
</Base>

<style>
  .bench {
    padding-block: clamp(32px, 4vw, 56px) clamp(48px, 6vw, 80px);
    min-height: calc(100svh - 64px);
  }

  .bench__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 40px;
    padding-bottom: 24px;
    margin-bottom: 0;
    border-bottom: 1px solid var(--rule);
  }

  .bench__head h1 {
    font-size: clamp(36px, 5vw, 64px);
  }

  .bench__head .lead {
    margin: 0;
    font-size: var(--t-m);
  }
</style>
