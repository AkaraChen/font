---
import { families } from '../../data/families'
import { upstreams } from '../../data/upstreams'
import { localePath, useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'
import PageHead from '../PageHead.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const description = locale === 'zh'
  ? `AKR 用到的全部上游字体：${upstreams.map(u => u.name.zh).join('、')}。每个上游一页，说明原版是什么、AKR 做了什么、差别在哪。`
  : `Every upstream AKR builds on: ${upstreams.map(u => u.name.en).join(', ')}. One page each — what the original is, what AKR made of it, and how they differ.`
---

<Base locale={locale} title={t('upstream.title')} description={description} path="/upstream">
  <PageHead marks={[t('upstream.title')]} title={t('home.upstream.heading')} lead={t('home.upstream.intro')} />

  <div class="page">
    <ol class="list">
      {upstreams.map((upstream, index) => (
        <li class="folio list__item">
          <div class="folio__margin list__marks">
            <span class="label"><span class="num">{String(index + 1).padStart(2, '0')}</span></span>
            <span class="label">{upstream.license}</span>
          </div>
          <div class="folio__body">
            <a class="list__name" href={localePath(locale, `/upstream/${upstream.slug}`)}>{upstream.name[locale]}</a>
            <p class="list__what">{upstream.what[locale]}</p>
            <p class="label">
              {upstream.author}<span aria-hidden="true"> · </span>
              {upstream.families.map(id => families.find(f => f.id === id)?.product).filter(Boolean).join(' · ')}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</Base>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .list__item {
    padding-block: var(--s-3) var(--s-3);
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }

  .list__marks {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .list__name {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 28px);
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .list__name:hover {
    color: var(--accent);
  }

  .list__what {
    max-width: var(--measure);
    color: var(--ink-muted);
    margin: var(--s-1) 0 var(--s-2);
  }

  .list__item .label {
    margin: 0;
  }

  @media (max-width: 860px) {
    .list__marks {
      flex-direction: row;
      gap: 14px;
    }
  }
</style>
