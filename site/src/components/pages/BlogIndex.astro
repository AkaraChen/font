---
import { getCollection } from 'astro:content'
import { localePath, useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'
import PageHead from '../PageHead.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const posts = (await getCollection('blog', post => post.data.lang === locale && !post.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const description = locale === 'zh'
  ? '关于中文编程字体的长文：怎么选、网格是怎么回事、上游字体各自适合做成什么。'
  : 'Long-form writing on CJK coding fonts: how to choose one, what the grid actually does, and what each upstream is good for.'
---

<Base locale={locale} title={t('blog.title')} description={description} path="/blog"
  markdown={false}>
  <PageHead marks={[t('blog.title')]} title={t('blog.title')} lead={description} />

  <div class="page">
    {posts.length === 0
      ? <p class="lead">{t('blog.empty')}</p>
      : (
          <ol class="list">
            {posts.map(post => (
              <li>
                <a class="folio list__item" href={localePath(locale, `/blog/${post.data.pair ?? post.id}`)}>
                  <time class="folio__margin label" datetime={post.data.date.toISOString()}>
                    {post.data.date.toISOString().slice(0, 10)}
                  </time>
                  <span class="folio__body">
                    <span class="list__title">{post.data.title}</span>
                    <span class="list__desc">{post.data.description}</span>
                    <span class="label list__more">{t('blog.readMore')} →</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        )}
  </div>
</Base>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--ink);
  }

  .list__item {
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    align-items: baseline;
  }

  .list__item .folio__margin {
    padding-top: 0.6em;
  }

  .list__title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    max-width: 18em;
  }

  .list__desc {
    display: block;
    max-width: var(--measure);
    color: var(--ink-muted);
    margin: var(--s-2) 0;
  }

  .list__item:hover .list__title {
    color: var(--accent);
  }
</style>
