---
import { getCollection } from 'astro:content'
import { localePath, useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'
import Cover from '../Cover.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const posts = (await getCollection('blog', post => post.data.lang === locale && !post.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())

const description = locale === 'zh'
  ? '关于中文编程字体的长文：怎么选、网格是怎么回事、上游字体各自适合做成什么。'
  : 'Long-form writing on CJK coding fonts: how to choose one, what the grid actually does, and what each upstream is good for.'
---

<Base locale={locale} title={t('blog.title')} description={description} path="/blog"
  markdown={false}>
  <Cover locale={locale} marks={[t('blog.title')]} title={t('blog.title')} lead={description} char="文" />

  <section class="band">
    <div class="wrap">
      {posts.length === 0
        ? <p class="lead">{t('blog.empty')}</p>
        : (
            <ol class="list">
              {posts.map((post, index) => (
                <li>
                  <a class="entry" href={localePath(locale, `/blog/${post.data.pair ?? post.id}`)}>
                    <span class="entry__no">{String(index + 1).padStart(2, '0')}</span>
                    <span class="entry__body">
                      <time class="label" datetime={post.data.date.toISOString()}>
                        {post.data.date.toISOString().slice(0, 10)}
                      </time>
                      <span class="entry__title">{post.data.title}</span>
                      <span class="entry__desc">{post.data.description}</span>
                      <span class="label entry__more">{t('blog.readMore')} →</span>
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          )}
    </div>
  </section>
</Base>

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .entry {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    padding-block: 40px;
    border-top: 1px solid var(--fg);
    text-decoration: none;
  }

  .entry__no {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(64px, 10vw, 140px);
    line-height: 0.8;
    color: var(--mark);
  }

  .entry__title {
    display: block;
    margin: 8px 0 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--t-xl);
    line-height: 1.15;
    letter-spacing: -0.02em;
    max-width: 18em;
  }

  .entry__desc {
    display: block;
    max-width: var(--measure);
    color: var(--fg-2);
    font-size: var(--t-l);
    line-height: 1.7;
  }

  .entry__more {
    margin-top: 20px;
    color: var(--fg);
  }

  .entry:hover .entry__title {
    color: var(--mark);
  }
</style>
