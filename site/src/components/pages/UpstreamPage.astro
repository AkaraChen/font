---
import { families } from '../../data/families'
import type { Upstream } from '../../data/upstreams'
import { localePath, useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'
import PageHead from '../PageHead.astro'
import Plate from '../Plate.astro'
import SectionHead from '../SectionHead.astro'

interface Props {
  locale: Locale
  upstream: Upstream
}

const { locale, upstream } = Astro.props
const t = useTranslations(locale)

const used = families.filter(family => upstream.families.includes(family.id))
const name = upstream.name[locale]

const title = locale === 'zh'
  ? `${name} 的编程字体版本：${used.map(f => f.product).join(' / ')}`
  : `${name} as a coding font: ${used.map(f => f.product).join(' / ')}`

const description = locale === 'zh'
  ? `把 ${name} 做成中英等宽编程字体：${used.map(f => f.product).join('、')}，严格 2:1 网格、Nerd 图标、SIL OFL 1.1。本页不是 ${name} 官方页面。`
  : `${name} turned into a CJK monospace coding font: ${used.map(f => f.product).join(', ')}. Strict 2:1 grid, Nerd icons, SIL OFL 1.1. Not an official ${name} page.`

const notOfficial = t('upstream.notOfficial').replaceAll('{name}', name)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': title,
  'description': description,
  'about': { '@type': 'CreativeWork', 'name': upstream.name.en, 'url': upstream.url },
}
---

<Base locale={locale} title={title} description={description} path={`/upstream/${upstream.slug}`} jsonLd={jsonLd}>
  <article>
    <PageHead marks={[t('upstream.title'), upstream.author, upstream.license]} title={name}>
      <p class="lead">
        {t('upstream.original')}: <a href={upstream.url} rel="noopener">{upstream.url.replace('https://', '')}</a>
      </p>
      <p class="notice">{notOfficial}</p>
    </PageHead>

    <section class="page section">
      <SectionHead n="01" label={t('upstream.what')} title={t('upstream.what')} />
      <div class="folio"><p class="prose">{upstream.what[locale]}</p></div>
    </section>

    <section class="page section">
      <SectionHead n="02" label={t('upstream.akr')} title={t('upstream.akr')} />
      <div class="folio"><p class="prose">{upstream.what_akr_does[locale]}</p></div>
    </section>

    <section class="page section">
      <SectionHead n="03" label={t('upstream.families')} title={t('upstream.families')} />
      <div class="used">
        {used.map(family => (
          <div class="used__item">
            <Plate
              family={family}
              tag="a"
              href={localePath(locale, `/family/${family.id}`)}
              size="clamp(72px, 9vw, 120px)"
              caption={[family.product, `${t('family.grid')} ${family.grid}`]}
              foot={[`${family.latin} × ${family.cjk}`, '→']}
            />
          </div>
        ))}
      </div>
      <div class="folio rfn">
        <p class="prose">
          {locale === 'zh'
            ? `AKR 的产品名不使用 ${name} 的保留字体名。上游按 ${upstream.license} 发布，衍生产品同样按 ${upstream.license} 发布。`
            : `No AKR product name uses a ${name} reserved font name. Upstream ships under ${upstream.license}, and so does this derivative.`}
        </p>
      </div>
    </section>
  </article>
</Base>

<style>
  .notice {
    max-width: var(--measure);
    font-size: 15px;
    color: var(--ink-muted);
    border-left: 2px solid var(--accent);
    padding-left: var(--s-2);
    margin-top: var(--s-3);
  }

  .used {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 460px), 1fr));
    gap: var(--s-4);
  }

  .used :global(.plate__glyphs.is-pixel) {
    font-size: 96px;
  }

  .rfn {
    margin-top: var(--s-4);
  }

  .rfn p {
    font-size: 15px;
  }
</style>
