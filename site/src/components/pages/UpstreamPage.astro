---
import { families } from '../../data/families'
import type { Upstream } from '../../data/upstreams'
import { useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'
import FamilyBand from '../FamilyBand.astro'
import Head from '../Head.astro'

interface Props {
  locale: Locale
  upstream: Upstream
}

const { locale, upstream } = Astro.props
const t = useTranslations(locale)

const used = families.filter(family => upstream.families.includes(family.id))
const name = upstream.name[locale]

const title = locale === 'zh'
  ? `${name} 的编程字体版本：${used.map(f => f.product).join(' / ')}`
  : `${name} as a coding font: ${used.map(f => f.product).join(' / ')}`

const description = locale === 'zh'
  ? `把 ${name} 做成中英等宽编程字体：${used.map(f => f.product).join('、')}，严格 2:1 网格、Nerd 图标、SIL OFL 1.1。本页不是 ${name} 官方页面。`
  : `${name} turned into a CJK monospace coding font: ${used.map(f => f.product).join(', ')}. Strict 2:1 grid, Nerd icons, SIL OFL 1.1. Not an official ${name} page.`

const notOfficial = t('upstream.notOfficial').replaceAll('{name}', name)

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  'name': title,
  'description': description,
  'about': { '@type': 'CreativeWork', 'name': upstream.name.en, 'url': upstream.url },
}
---

<Base locale={locale} title={title} description={description} path={`/upstream/${upstream.slug}`} jsonLd={jsonLd}>
  <article>
    <header class="band cover">
      <div class="wrap">
        <p class="label cover__marks"><span class="seal">{t('upstream.title')}</span> · {upstream.author} · {upstream.license}</p>
        <h1>{name}</h1>
        <p class="cover__original">
          <span class="label">{t('upstream.original')}</span>
          <a href={upstream.url} rel="noopener">{upstream.url.replace('https://', '')} ↗</a>
        </p>
        <p class="notice">{notOfficial}</p>
      </div>
    </header>

    <section class="band band--tint">
      <div class="wrap">
        <Head locale={locale} n={1} title={locale === 'zh' ? '原版与 AKR' : 'Original and AKR'} />
        <div class="compare">
          <div>
            <p class="label">{t('upstream.what')}</p>
            <p class="compare__text">{upstream.what[locale]}</p>
          </div>
          <div>
            <p class="label seal">{t('upstream.akr')}</p>
            <p class="compare__text">{upstream.what_akr_does[locale]}</p>
          </div>
        </div>
      </div>
    </section>

    <section class="band used__head">
      <div class="wrap">
        <Head locale={locale} n={2} title={t('upstream.families')} />
      </div>
    </section>
    {used.map((family, index) => (
      <FamilyBand
        locale={locale}
        family={family}
        index={families.findIndex(f => f.id === family.id) + 1}
        total={families.length}
        tone={index % 2 === 0 ? 'ink' : 'paper'}
        flip={index % 2 === 1}
      />
    ))}

    <section class="band">
      <div class="wrap">
        <p class="prose rfn">
          {locale === 'zh'
            ? `AKR 的产品名不使用 ${name} 的保留字体名。上游按 ${upstream.license} 发布，衍生产品同样按 ${upstream.license} 发布。`
            : `No AKR product name uses a ${name} reserved font name. Upstream ships under ${upstream.license}, and so does this derivative.`}
        </p>
      </div>
    </section>
  </article>
</Base>

<style>
  .seal {
    color: var(--seal);
  }

  .cover {
    padding-block: clamp(48px, 7vw, 104px);
    border-bottom: 1px solid var(--ink);
  }

  .cover__marks {
    margin-bottom: 24px;
  }

  .cover h1 {
    font-size: clamp(56px, 11vw, 168px);
    line-height: 1;
  }

  .cover__original {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 16px;
    margin: 32px 0 0;
    font-family: var(--font-display);
    font-size: var(--t-l);
  }

  .notice {
    max-width: var(--measure);
    font-size: 15px;
    color: var(--fg-2);
    border-left: 3px solid var(--seal);
    padding-left: 16px;
    margin: 28px 0 0;
  }

  .compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(32px, 5vw, 80px);
  }

  .compare > div {
    border-top: 1px solid var(--rule);
    padding-top: 16px;
  }

  .compare__text {
    margin-top: 12px;
    font-size: var(--t-l);
    line-height: 1.8;
  }

  .used__head {
    padding-bottom: clamp(24px, 3vw, 40px);
  }

  .used__head :global(.head) {
    margin-bottom: 0;
  }

  .rfn {
    font-size: 15px;
    margin: 0;
  }

  @media (max-width: 860px) {
    .compare {
      grid-template-columns: 1fr;
    }
  }
</style>
