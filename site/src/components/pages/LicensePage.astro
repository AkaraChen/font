---
import { families } from '../../data/families'
import { upstreams } from '../../data/upstreams'
import { localePath, useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'
import PageHead from '../PageHead.astro'
import SectionHead from '../SectionHead.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const description = locale === 'zh'
  ? 'AKR 字体按 SIL OFL 1.1 发布，构建脚本按 MIT 发布。本页列出全部上游字体、作者与许可证。'
  : 'AKR fonts ship under SIL OFL 1.1 and the build recipes under MIT. This page lists every upstream font, its author and its license.'
---

<Base locale={locale} title={t('license.title')} description={description} path="/license">
  <PageHead marks={[t('license.title'), 'SIL OFL 1.1', 'MIT']} title={t('license.title')} lead={t('license.fonts')}>
    <p class="prose">{t('license.rfn')}</p>
  </PageHead>

  <section class="page section">
    <SectionHead n="01" label={t('license.thanks')} title={t('license.thanks')} />
    <div class="table-wrap">
      <table class="spec-table">
        <thead>
          <tr>
            <th scope="col">{t('upstream.title')}</th>
            <th scope="col">{locale === 'zh' ? '作者' : 'Author'}</th>
            <th scope="col">{locale === 'zh' ? '许可' : 'License'}</th>
            <th scope="col">{t('upstream.families')}</th>
          </tr>
        </thead>
        <tbody>
          {upstreams.map(upstream => (
            <tr>
              <td><a href={upstream.url} rel="noopener">{upstream.name[locale]}</a></td>
              <td>{upstream.author}</td>
              <td>{upstream.license}</td>
              <td>
                {upstream.families.map((id, index) => {
                  const family = families.find(f => f.id === id)
                  return family
                    ? (
                        <>
                          {index > 0 && <span aria-hidden="true"> · </span>}
                          <a href={localePath(locale, `/family/${family.id}`)}>{family.product}</a>
                        </>
                      )
                    : null
                })}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .table-wrap {
    overflow-x: auto;
  }

  .spec-table th {
    width: auto;
  }

  .spec-table td {
    font-size: 14.5px;
    color: var(--ink-muted);
  }

  .spec-table td:first-child {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }

  .spec-table td:nth-child(3) {
    font-family: var(--font-label);
    font-size: var(--t-meta);
    white-space: nowrap;
  }
</style>
