---
import type { Family } from '../../data/families'
import { families } from '../../data/families'
import { cssFamily, downloadUrl, hasFonts, manifest } from '../../data/fonts'
import { upstreams } from '../../data/upstreams'
import { localePath, useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'
import FontPreview from '../FontPreview.astro'
import Plate from '../Plate.astro'
import SectionHead from '../SectionHead.astro'

interface Props {
  locale: Locale
  family: Family
}

const { locale, family } = Astro.props
const t = useTranslations(locale)

const related = upstreams.filter(upstream => family.upstreams.includes(upstream.slug))
const siblings = families.filter(f => f.id !== family.id && f.upstreams.some(u => family.upstreams.includes(u)))

const title = locale === 'zh'
  ? `${family.product}｜${family.tagline.zh}`
  : `${family.product} — ${family.tagline.en}`

const description = locale === 'zh'
  ? `${family.product}：${family.latin} 拉丁 × ${family.cjk} 汉字，${family.grid} 网格${family.nerd ? '、含 Nerd 图标' : ''}，SIL OFL 1.1 免费下载。`
  : `${family.product}: ${family.latin} Latin with ${family.cjk} CJK on a ${family.grid} grid${family.nerd ? ', Nerd icons included' : ''}. Free under SIL OFL 1.1.`

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  'name': family.product,
  'description': description,
  'license': 'https://scripts.sil.org/OFL',
  'isBasedOn': related.map(upstream => ({ '@type': 'CreativeWork', 'name': upstream.name.en, 'url': upstream.url })),
  'author': {
    '@type': 'Person',
    'name': 'AkaraChen',
    'url': 'https://github.com/AkaraChen',
  },
  'isAccessibleForFree': true,
}

const faqJsonLd = family.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      'mainEntity': family.faq.map(item => ({
        '@type': 'Question',
        'name': item.q[locale],
        'acceptedAnswer': { '@type': 'Answer', 'text': item.a[locale] },
      })),
    }
  : undefined

const jsonLdBlocks = faqJsonLd ? [jsonLd, faqJsonLd] : [jsonLd]

const pixel = family.id === 'pixel'
// The waterfall: the same line at the sizes a coding face actually lives at.
// Pixel only renders cleanly at whole multiples of its 12px bitmap.
const waterfall = pixel ? [12, 24, 36, 48] : [13, 16, 22, 32, 44]
const face = hasFonts ? `font-family:"${cssFamily(family.id)}", ui-monospace, monospace` : undefined

let section = 0
const next = () => String(++section).padStart(2, '0')
---

<Base locale={locale} title={title} description={description} path={`/family/${family.id}`} jsonLd={jsonLdBlocks}>
  <article>
    <div class="page">
      <header class="folio page-head">
        <ul class="folio__margin marks">
          <li class="label"><b>{family.product}</b></li>
          <li class="label">{t('family.grid')} {family.grid}</li>
          <li class="label">{family.weights.join(' / ')}</li>
          {family.nerd && <li class="label">{t('family.nerd')}</li>}
        </ul>
        <div class="folio__body">
          <h1>{family.name[locale]}</h1>
          <p class="lead">{family.tagline[locale]}</p>
          <div class="actions">
            {manifest.tag && (
              <a class="button" href={downloadUrl(manifest.tag, family.product)} rel="noopener">
                {t('family.download')}<span class="tag">{manifest.tag}</span>
              </a>
            )}
            <a class="button button--ghost" href={localePath(locale, `/preview?family=${family.id}`)}>{t('family.preview')}</a>
            <a class="button button--ghost" href={`https://github.com/${manifest.repo}/tree/main/${family.dir}`} rel="noopener">
              {t('family.source')}
            </a>
          </div>
        </div>
      </header>

      <Plate
        family={family}
        caption={[family.product, `${t('family.grid')} ${family.grid}`]}
        foot={[`${family.latin} × ${family.cjk}`, family.weights.join(' · ')]}
      />

      <div class="folio intro">
        <p class="folio__body">{family.intro[locale]}</p>
      </div>
    </div>

    <section class="page section">
      <SectionHead n={next()} label={t('home.specimen')} />
      <ol class="waterfall" style={face}>
        {waterfall.map(size => (
          <li class="folio">
            <span class="folio__margin label">{size}px</span>
            <span class:list={['folio__body', 'waterfall__line', { 'is-pixel': pixel }]} style={`font-size:${size}px`}>{family.sample}</span>
          </li>
        ))}
      </ol>
    </section>

    <section class="page section">
      <SectionHead n={next()} label={t('family.spec')} title={t('family.spec')} />
      <div class="folio">
        <table class="spec-table">
          <tbody>
            {family.spec.map(row => (
              <tr>
                <th scope="row">{row.label[locale]}</th>
                <td>{row.value[locale]}</td>
              </tr>
            ))}
            <tr>
              <th scope="row">{t('family.weights')}</th>
              <td>{family.weights.join(' · ')}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="page section">
      <SectionHead n={next()} label={t('family.preview')} title={t('family.preview')} />
      <FontPreview locale={locale} initial={family.id} only={[family.id]} />
    </section>

    <section class="page section">
      <SectionHead n={next()} label={t('family.upstream')} title={t('family.upstream')} />
      <div class="folio">
        <div class="folio__body">
          <p class="prose">{t('family.derived')}</p>
          <ul class="ruled">
            {related.map(upstream => (
              <li>
                <a class="ruled__name" href={localePath(locale, `/upstream/${upstream.slug}`)}>{upstream.name[locale]}</a>
                <span class="label">{upstream.author} · <a href={upstream.url} rel="noopener">{upstream.url.replace('https://', '')}</a></span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    {family.faq.length > 0 && (
      <section class="page section">
        <SectionHead n={next()} label={t('family.faq')} title={t('family.faq')} />
        <dl class="faq">
          {family.faq.map(item => (
            <div class="folio faq__item">
              <dt class="folio__body">{item.q[locale]}</dt>
              <dd class="folio__body">{item.a[locale]}</dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {siblings.length > 0 && (
      <section class="page section">
        <SectionHead n={next()} label={t('family.related')} />
        <div class="folio">
          <ul class="ruled folio__body">
            {siblings.map(sibling => (
              <li>
                <a class="ruled__name" href={localePath(locale, `/family/${sibling.id}`)}>{sibling.name[locale]}</a>
                <span class="ruled__text">{sibling.tagline[locale]}</span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </article>
</Base>

<style>
  .marks {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .marks li {
    padding-block: 6px;
    border-bottom: 1px solid var(--rule-soft);
  }

  .page-head .lead {
    margin-block: var(--s-3) var(--s-4);
  }

  .tag {
    opacity: 0.6;
  }

  .intro {
    padding-block: var(--s-5) var(--s-6);
  }

  .intro p {
    font-size: var(--t-lead);
    line-height: 1.8;
    max-width: var(--measure);
    margin: 0;
  }

  .waterfall {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .waterfall li {
    align-items: baseline;
    padding-block: 10px;
    border-bottom: 1px solid var(--rule-soft);
  }

  .waterfall__line {
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .ruled {
    list-style: none;
    padding: 0;
    margin: var(--s-3) 0 0;
    border-top: 1px solid var(--rule);
  }

  .ruled li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px var(--s-3);
    padding-block: 14px;
    border-bottom: 1px solid var(--rule-soft);
  }

  .ruled__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    text-decoration: none;
  }

  .ruled__name:hover {
    color: var(--accent);
  }

  .ruled__text {
    color: var(--ink-muted);
    font-size: 15px;
  }

  .faq {
    margin: 0;
  }

  .faq__item {
    padding-block: var(--s-3);
    border-top: 1px solid var(--rule-soft);
  }

  .faq__item:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .faq dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.5;
    max-width: var(--measure);
  }

  .faq dd {
    margin: 10px 0 0;
    color: var(--ink-muted);
    max-width: var(--measure);
  }

  @media (max-width: 860px) {
    .marks {
      display: flex;
      flex-wrap: wrap;
      gap: 0 14px;
      margin-bottom: var(--s-2);
    }

    .marks li {
      border: 0;
      padding: 0;
    }

    .waterfall .folio__margin {
      margin-bottom: -4px;
    }
  }
</style>
