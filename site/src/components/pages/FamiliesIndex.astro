---
import { families } from '../../data/families'
import { manifest } from '../../data/fonts'
import { localePath, useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'
import PageHead from '../PageHead.astro'
import SectionHead from '../SectionHead.astro'
import SpecimenStrip from '../SpecimenStrip.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useTranslations(locale)

const description = locale === 'zh'
  ? `AKR 的八套中英混排编程字体：${families.map(f => f.product).join('、')}。每套都列出拉丁与汉字上游、网格、字重与许可。`
  : `The eight AKR CJK coding fonts: ${families.map(f => f.product).join(', ')}. Latin and CJK upstream, grid, weights and license for each.`
---

<Base locale={locale} title={t('nav.families')} description={description} path="/families">
  <PageHead
    marks={[t('nav.families'), manifest.tag]}
    title={t('home.families.heading')}
    lead={t('home.specimen.note')}
  />

  <section class="page section">
    <SectionHead n="01" label={t('home.specimen')} />
    <SpecimenStrip locale={locale} />
  </section>

  <section class="page section">
    <SectionHead n="02" label={t('family.spec')} />
    <div class="table-wrap">
      <table class="spec-table">
        <thead>
          <tr>
            <th scope="col">{t('nav.families')}</th>
            <th scope="col">Latin</th>
            <th scope="col">CJK</th>
            <th scope="col">{t('family.grid')}</th>
            <th scope="col">{t('family.weights')}</th>
          </tr>
        </thead>
        <tbody>
          {families.map(family => (
            <tr>
              <td><a href={localePath(locale, `/family/${family.id}`)}>{family.product}</a></td>
              <td>{family.latin}</td>
              <td>{family.cjk}</td>
              <td>{family.grid}</td>
              <td>{family.weights.join(' · ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>

<style>
  .table-wrap {
    overflow-x: auto;
  }

  .spec-table th {
    width: auto;
  }

  .spec-table td {
    font-size: 14px;
    color: var(--ink-muted);
  }

  .spec-table td:first-child {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }

  .spec-table td:nth-child(4) {
    font-family: var(--font-label);
    font-size: var(--t-meta);
    white-space: nowrap;
  }
</style>
