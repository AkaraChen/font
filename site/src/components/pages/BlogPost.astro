---
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'
import { localePath, useTranslations, type Locale } from '../../i18n/ui'
import Base from '../../layouts/Base.astro'

interface Props {
  locale: Locale
  post: CollectionEntry<'blog'>
}

const { locale, post } = Astro.props
const t = useTranslations(locale)
const { Content } = await render(post)

const slug = post.data.pair ?? post.id

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': post.data.title,
  'description': post.data.description,
  'datePublished': post.data.date.toISOString(),
  'inLanguage': locale === 'zh' ? 'zh-Hans' : 'en',
  'author': { '@type': 'Person', 'name': 'AkaraChen' },
}
---

<Base
  locale={locale}
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${slug}`}
  jsonLd={jsonLd}
  markdown={false}
>
  <article class="page">
    <header class="folio page-head">
      <div class="folio__margin post__marks">
        <a class="label" href={localePath(locale, '/blog')}>← {t('blog.title')}</a>
        <time class="label" datetime={post.data.date.toISOString()}>
          {post.data.date.toISOString().slice(0, 10)}
        </time>
      </div>
      <div class="folio__body">
        <h1>{post.data.title}</h1>
        <p class="lead">{post.data.description}</p>
      </div>
    </header>
    <div class="folio post">
      <div class="folio__body post__body">
        <Content />
      </div>
    </div>
  </article>
</Base>

<style>
  .post__marks {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .post__marks a {
    text-decoration: none;
  }

  .post__marks a:hover {
    color: var(--ink);
  }

  .page-head h1 {
    font-size: clamp(34px, 5vw, 64px);
  }

  .post {
    border-top: 1px solid var(--ink);
    padding-top: var(--s-5);
  }

  .post__body {
    color: var(--ink-muted);
    max-width: var(--measure);
    font-size: 18px;
    line-height: 1.9;
  }

  .post__body > :global(p:first-child) {
    color: var(--ink);
    font-size: var(--t-lead);
  }

  .post__body :global(h2) {
    font-size: clamp(22px, 2.4vw, 28px);
    margin-top: var(--s-5);
    margin-bottom: var(--s-2);
    padding-top: var(--s-2);
    border-top: 1px solid var(--rule);
    color: var(--ink);
  }

  .post__body :global(h3) {
    margin-top: var(--s-4);
    margin-bottom: var(--s-1);
    color: var(--ink);
  }

  .post__body :global(p) {
    margin-bottom: 1.2em;
  }

  .post__body :global(strong) {
    color: var(--ink);
  }

  .post__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    margin: var(--s-3) 0 var(--s-4);
    border-top: 1px solid var(--ink);
  }

  .post__body :global(th),
  .post__body :global(td) {
    text-align: left;
    padding: 10px var(--s-2) 10px 0;
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: baseline;
  }

  .post__body :global(th) {
    font-family: var(--font-label);
    font-size: var(--t-label);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .post__body :global(pre) {
    background: var(--dark-bg);
    color: var(--dark-ink);
    padding: var(--s-3);
    margin: var(--s-3) 0 var(--s-4);
    overflow-x: auto;
    font-size: 14px;
    line-height: 1.7;
  }

  .post__body :global(code) {
    font-size: 0.88em;
  }

  .post__body :global(blockquote) {
    margin: var(--s-3) 0;
    padding-left: var(--s-3);
    border-left: 2px solid var(--accent);
    color: var(--ink);
  }
</style>
