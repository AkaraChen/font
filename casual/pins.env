# Pinned upstream inputs for RecursiveYozai Dual
# Recursive Mono Casual (Latin) + Yozai 悠哉 (CJK), strict 2:1 dual-width.
# Reproducible build: change these deliberately; record why in the commit.
# Experiment / product from KIT-261.

# --- Latin: Recursive Mono Casual (static TTF) ------------------------------
# Release: https://github.com/arrowtype/recursive/releases/tag/v1.085
# Product uses the *Casual* mono statics (Csl), not Linear (Lnr).
# Desktop zip ships separate_statics/TTF/RecursiveMonoCslSt-{Regular,Bold}.ttf
RECURSIVE_REPO=https://github.com/arrowtype/recursive
RECURSIVE_RELEASE_TAG=v1.085
RECURSIVE_ZIP_URL='https://github.com/arrowtype/recursive/releases/download/v1.085/ArrowType-Recursive-1.085.zip'
RECURSIVE_ZIP_SHA256=cbcbdf7a0e181d284a9235e09ed5f3873e527bc5dd1d977df71cdc1ff937da02
RECURSIVE_TTF_REGULAR='ArrowType-Recursive-1.085/Recursive_Desktop/separate_statics/TTF/RecursiveMonoCslSt-Regular.ttf'
RECURSIVE_TTF_BOLD='ArrowType-Recursive-1.085/Recursive_Desktop/separate_statics/TTF/RecursiveMonoCslSt-Bold.ttf'
# Member SHA-256 after extract (gates corruption without re-hashing the whole zip)
RECURSIVE_SHA256_REGULAR=4a405818af28b9cdf945a34254c226f5b18d350827bf517b6fb050699d632445
RECURSIVE_SHA256_BOLD=bc03d101684c98eb2961061cf6d2106f9ba43afc52bcd033d6710c80e9587f0a
# Upstream mono cell @ UPM 1000 → product half-cell 500 (uniform scale 500/600)
LATIN_SRC_ADV=600
LATIN_SRC_UPM=1000
LATIN_UNIFORM_SCALE=0.833333333

# --- CJK: Yozai 悠哉 ---------------------------------------------------------
# Release: https://github.com/lxgw/yozai-font/releases/tag/v0.868
# Handwriting-style CJK (YozFont derivative), SIL OFL 1.1.
YOZAI_REPO=https://github.com/lxgw/yozai-font
YOZAI_RELEASE_TAG=v0.868
YOZAI_TTF_URL_REGULAR='https://github.com/lxgw/yozai-font/releases/download/v0.868/Yozai-Regular.ttf'
YOZAI_TTF_URL_MEDIUM='https://github.com/lxgw/yozai-font/releases/download/v0.868/Yozai-Medium.ttf'
YOZAI_SHA256_REGULAR=25071998a0fe6a72f54c235e714986d259633e5ff670b1a2b5e264387f3316ac
YOZAI_SHA256_MEDIUM=05f50f252b45197d0d6148a4abc3e37c7cd4cfdf03c955b57c25d53d924f835f
# Weight pairing (measured vertical-stem medians @ UPM 1000, after Latin scale):
#   Recursive Mono Casual Regular @ cell 500: v≈78
#   Yozai Regular raw v≈56 → embolden s=10 → v≈76 (Δv≈−2)
#   Recursive Mono Casual Bold @ cell 500: v≈112
#   Yozai Medium raw v≈68 → embolden s=20 → v≈108 (Δv≈−4)
YOZAI_FOR_REGULAR=Regular
YOZAI_FOR_BOLD=Medium
CJK_EMBOLDEN_REGULAR=10
CJK_EMBOLDEN_BOLD=20
# Recursive Casual is upright — no CJK shear.
CJK_SLANT_DEG=0
CJK_SLANT_PIVOT_Y=375

# --- Product metrics --------------------------------------------------------
EN_ADV=500
CJK_ADV=1000
UPM=1000

# --- Product naming ---------------------------------------------------------
#   Recursive = Recursive Mono Casual (Latin)
#   Yozai     = 悠哉 (CJK handwriting)
#   Dual      = 2:1 dual-width coding product (no Nerd patch in v0.1)
# Windows name ID 1 ≤ 31 chars: "RecursiveYozai Dual" = 19.
# OFL RFN: Recursive reserves "Recursive"; Yozai/Y.Oz reserve Y.Oz / YOz names.
# "RecursiveYozai" is a project product label — review RFN before public OFL
# redistribution (same caveat as RadonWenKai / YuanTi in this repo).
FAMILY_NAME='RecursiveYozai Dual'
FAMILY_PS=RecursiveYozaiDual
PRODUCT_STEM=RecursiveYozaiDual
FAMILY_SUFFIX=
PRODUCT_VERSION=0.1.0

# --- Vertical metrics (coding-oriented blend) -------------------------------
HHEA_ASCENT=950
HHEA_DESCENT=-250
HHEA_LINE_GAP=0
OS2_TYPO_ASCENDER=880
OS2_TYPO_DESCENDER=-220
OS2_TYPO_LINE_GAP=0
OS2_WIN_ASCENT=1032
OS2_WIN_DESCENT=290
