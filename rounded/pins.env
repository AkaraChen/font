# Pinned upstream inputs for IosevkaCurlyRHR NFM（圆体）
# Iosevka Curly (ss20 Curly Style, sans — not Slab/NSlab) + Resource Han Rounded SC
# + Nerd Font Mono, dual-width 2:1.
# Reproducible build: change these deliberately; record why in the commit.

# --- Latin: Iosevka Curly (ss20 Curly Style, prebuilt package) ---------------
# Release: https://github.com/be5invis/Iosevka/releases/tag/v34.8.0
# Why Curly / ss20: rounded terminals match Resource Han Rounded corners and the
# product name 圆体. Other inherits ranked in README (ss17 soft, ss14 modern,
# ss15 industrial — all less “round path” than Curly).
# Package is sans Curly, NOT CurlySlab / NSlab (serif product already uses slab).
IOSEVKA_REPO=https://github.com/be5invis/Iosevka
IOSEVKA_RELEASE_TAG=v34.8.0
IOSEVKA_VARIANT=Curly
IOSEVKA_STYLE_NOTE='ss20 Curly Style (PkgTTF-IosevkaCurly)'
IOSEVKA_ZIP_URL='https://github.com/be5invis/Iosevka/releases/download/v34.8.0/PkgTTF-IosevkaCurly-34.8.0.zip'
IOSEVKA_ZIP_SHA256=9a126d1cda838c1646943044d3b27693fa0d2f827787c5821e95de13d9ed0ac0
# Members inside the zip
IOSEVKA_TTF_REGULAR=IosevkaCurly-Regular.ttf
IOSEVKA_TTF_BOLD=IosevkaCurly-Bold.ttf
# Upstream mono cell @ UPM 1000 (verified from 'M' advance after extract)
LATIN_SRC_ADV=500
LATIN_SRC_UPM=1000
LATIN_TARGET_UPM=1000

# --- CJK: Resource Han Rounded SC (资源圆体) --------------------------------
# Release: https://github.com/CyanoHao/Resource-Han-Rounded/releases/tag/v0.990
# CN subset package (Simplified Chinese masters).
RHR_REPO=https://github.com/CyanoHao/Resource-Han-Rounded
RHR_RELEASE_TAG=v0.990
RHR_ZIP_URL='https://github.com/CyanoHao/Resource-Han-Rounded/releases/download/v0.990/RHR-CN-0.990.7z'
RHR_ZIP_SHA256=e7005f7b4a7a0b8352d32c4a1358ff47564eb73be7fdb2db00d9f792755e9dc7
RHR_TTF_REGULAR=ResourceHanRoundedCN-Regular.ttf
RHR_TTF_BOLD=ResourceHanRoundedCN-Bold.ttf

# Optical weight: start at 0/0 (RHR has real Bold). Re-run calibrate later if needed.
CJK_EMBOLDEN_REGULAR=0
CJK_EMBOLDEN_BOLD=0

# --- Product metrics --------------------------------------------------------
# Grid matches serif/handwriting (500/1000) — Iosevka native half-cell is 500.
EN_ADV=500
CJK_ADV=1000
UPM=1000

# --- Product naming ---------------------------------------------------------
# Source-encoding family (same recipe as LilexSansSC / SarasaNZSSlab):
#   Iosevka = Latin base
#   Curly   = ss20 Curly Style package (not Slab/NSlab)
#   RHR     = Resource Han Rounded SC
#   Dual    = pre-Nerd intermediate
#   NFM     = Nerd Font Mono product
# Windows name ID 1 ≤ 31 chars ("IosevkaCurlyRHR NFM" = 19).
# Docs may still call the direction 圆体; picker/install name is the compound.
# OFL RFN: Iosevka reserves "Iosevka"; RHR/Source Han may reserve upstream names.
# Review RFN before public OFL redistribution.
BASE_FAMILY_NAME='IosevkaCurlyRHR Dual'
BASE_FAMILY_PS=IosevkaCurlyRHRDual
FAMILY_NAME='IosevkaCurlyRHR NFM'
FAMILY_PS=IosevkaCurlyRHRNFM
PRODUCT_STEM=IosevkaCurlyRHRNFM
FAMILY_SUFFIX=
# Direction nickname (docs / sample titles only — not the OT family name)
PRODUCT_NAME_ZH=圆体

# --- Vertical metrics (coding-oriented) -------------------------------------
HHEA_ASCENT=1000
HHEA_DESCENT=-200
HHEA_LINE_GAP=0
OS2_TYPO_ASCENDER=875
OS2_TYPO_DESCENDER=-125
OS2_TYPO_LINE_GAP=0
OS2_WIN_ASCENT=1050
OS2_WIN_DESCENT=250

# --- Nerd Fonts patcher ------------------------------------------------------
# Same pin as sans/ / serif/ / pixel/ / handwriting/ for a consistent icon set.
NERD_FONTS_PATCHER_VERSION=4.26.0
# A commit, not a release. FontPatcher.zip only exists for tagged releases, and
# the newest is still v3.4.0 (2025-04) carrying font-patcher 4.20.3 — while
# every product this repo released from CI was patched by the nerdfonts/patcher
# container, built from master and shipping 4.26.0. This is the commit that
# container was built from (its own org.opencontainers.image.revision label),
# so what the repo pins and what it ships are finally the same patcher.
NERD_FONTS_PATCHER_COMMIT=64b7726c2fc3fb9bfe74a3621d317a6d3319d908
NERD_FONTS_PATCHER_HASH=sha256-ilk38WIHygLsxo6BruwVaqTk/T+VobB4jzLc5jxcpL0=
