# Pinned upstream inputs for RadonWenKai NFM
# (Monaspace Radon NF Latin + 霞鹜文楷 LXGW WenKai CJK, 2:1 dual-width, Nerd icons)
# Reproducible build: change these deliberately; record why in the commit.

# --- Monaspace Radon NF (Latin / ligatures / Nerd icons) --------------------
# Release: https://github.com/githubnext/monaspace/releases/tag/v1.400
# The *nerdfonts* asset is a 315 MiB zip; scripts fetch only the two members
# they need via HTTP range requests (see scripts/fetch_zip_member.py), so the
# pin is a per-member sha256 instead of a whole-zip sha256.
MONASPACE_REPO=https://github.com/githubnext/monaspace
MONASPACE_RELEASE_TAG='v1.400'
MONASPACE_NF_ZIP_URL='https://github.com/githubnext/monaspace/releases/download/v1.400/monaspace-nerdfonts-v1.400.zip'
RADON_NF_MEMBER_REGULAR='NerdFonts/Monaspace Radon/MonaspaceRadonNF-Regular.otf'
RADON_NF_MEMBER_BOLD='NerdFonts/Monaspace Radon/MonaspaceRadonNF-Bold.otf'
RADON_NF_SHA256_REGULAR=7e8bed594c1708f8f45f312339dc182deec7461c47b8fff79f410646baa9a3d2
RADON_NF_SHA256_BOLD=81e3e1e8815073a0c979ce1ba327f91b74606d81478fe271d160fcad22fd60eb

# --- LXGW WenKai (CJK) ------------------------------------------------------
# Release: https://github.com/lxgw/LxgwWenKai/releases/tag/v1.522
# WenKai has no Bold; Medium is the heaviest shipped weight (Light/Regular/Medium).
# Weight pairing is measured, not guessed — see scripts/calibrate-stroke.sh.
WENKAI_REPO=https://github.com/lxgw/LxgwWenKai
WENKAI_RELEASE_TAG='v1.522'
WENKAI_TTF_URL_REGULAR='https://github.com/lxgw/LxgwWenKai/releases/download/v1.522/LXGWWenKai-Regular.ttf'
WENKAI_TTF_URL_MEDIUM='https://github.com/lxgw/LxgwWenKai/releases/download/v1.522/LXGWWenKai-Medium.ttf'
WENKAI_SHA256_REGULAR=39ad71264b588165b469e35e6afb162a378dacd1f95348160240ba9038ac3009
WENKAI_SHA256_MEDIUM=d4bdeb38a39151d74d084cba5090f8cb7d20bf83eedb78c35939ae70b9f4e3f6
# Which WenKai weight backs each product face (measured stroke match, KIT-248)
# Measured (KIT-248): Radon Regular v-stem ≈ 73.3 units @ UPM 1000, and WenKai
# Medium ≈ 77.6 — closer than Regular's 65.8, and a real design weight beats a
# stroked one. Same finding as LXGW Bright Code's Monaspace↔WenKai weight table.
WENKAI_FOR_REGULAR=Medium
WENKAI_FOR_BOLD=Medium

# --- Grid: strict 2:1 -------------------------------------------------------
# Monaspace ships a 1240/2000 em cell (0.62 em) — too wide to pair 2:1 with a
# 1 em CJK glyph without either gappy CJK or a heavy Latin squeeze. Same recipe
# as the reference LXGW Bright Code (Argon × WenKai): narrow the Latin cell
# 1240 → 1111 (x only), then scale the whole Latin face to 90 %, which lands
# the cell on exactly 1000/2000 em = 500/1000 em. WenKai is then used at its
# native 1000 em advance, untouched horizontally.
SRC_UPM=2000
UPM=1000
LATIN_SRC_ADV=1240
LATIN_NARROW_ADV=1111
LATIN_UNIFORM_SCALE=0.9
EN_ADV=500
CJK_ADV=1000

# --- CJK slant (match Radon's handwriting lean) -----------------------------
# Radon is nominally upright (post.italicAngle = 0) but its straight stems
# actually lean ~7.5° right. `scripts/measure-slant.py` regresses the ink-centre
# axis of H I T k E and reports the median; WenKai is sheared by that angle so
# the Kai strokes ride along with Radon instead of standing square next to it.
# Shear pivot: y = 375 (≈ half the Han ink height) keeps glyphs centred in cell.
CJK_SLANT_DEG=7.5
CJK_SLANT_PIVOT_Y=375

# --- CJK stroke weight matching (measured, not eyeballed) -------------------
# scanline stem medians, WenKai vs Radon Latin, in font units @ UPM 1000.
# Regular: WenKai Medium lands at +4.3 on its own → no stroking, keep the brush.
# Bold: Radon Bold is 107.2 and WenKai has nothing heavier than Medium (77.6),
# so the gap must be stroked; the sweep puts s=15 at +0.5.
# 0 = no embolden. See scripts/calibrate-stroke.sh + README table.
CJK_EMBOLDEN_REGULAR=0
CJK_EMBOLDEN_BOLD=15

# --- Ligatures --------------------------------------------------------------
# Monaspace keeps its coding ligatures in stylistic sets, not in `liga`/`calt`:
#   ss01 = / == / === / !=      ss02 <= >=            ss03 arrows -> <- <!--
#   ss04 markup </>             ss05 pipes |>         ss06 repeats +++ ### ___
#   ss07 ::                     ss08 raised .. ranges ss09 =>
#   ss10 (no effect in the probe battery; folded for completeness)
# Editors that only flip "font ligatures" (= calt) therefore show almost none of
# them. 05-expand-ligatures.sh unions these into calt so they are on by default;
# the ss** features stay intact for anyone toggling individually.
LIGATURE_SETS=ss01,ss02,ss03,ss04,ss05,ss06,ss07,ss08,ss09,ss10

# --- Product naming ---------------------------------------------------------
#   Radon    = Monaspace Radon (Latin / ligatures / OT features)
#   WenKai   = 霞鹜文楷 LXGW WenKai (CJK, sheared to Radon's lean)
#   NFM      = Nerd Font Mono product (icons at 1 cell) on a 2:1 dual grid
# Windows name ID 1 must stay ≤ 31 chars ("RadonWenKai NFM" = 15).
# ⚠ OFL reserved font names: Monaspace reserves "Monaspace" *and* its subfamily
# names, "Radon" among them; WenKai reserves 霞鹜 / 霞鶩 / 落霞孤鹜 / 落霞孤鶩 /
# "LXGW" (not the Latin "WenKai"). This family is a project source-encoding
# label in the same style as sans/'s LilexSansSC — fine locally, but RENAME
# before any public OFL redistribution. See README "Family / license".
FAMILY_NAME='RadonWenKai NFM'
FAMILY_PS=RadonWenKaiNFM
PRODUCT_STEM=RadonWenKaiNFM
FAMILY_SUFFIX=

# --- Vertical metrics (coding-oriented blend) -------------------------------
# Radon @ 0.45 y-scale: asc 850 / desc -180, cap 679, x-height 483.
# WenKai native: hhea 928/-256, typo 880/-120, win 1032/285 → win must cover
# WenKai's taller kana / punctuation, hhea gives a 1.20 em coding line.
HHEA_ASCENT=950
HHEA_DESCENT=-250
HHEA_LINE_GAP=0
OS2_TYPO_ASCENDER=880
OS2_TYPO_DESCENDER=-220
OS2_TYPO_LINE_GAP=0
OS2_WIN_ASCENT=1032
OS2_WIN_DESCENT=290
