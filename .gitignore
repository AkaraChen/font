# Build trees & products
# `out-<profile>-<region>` is `just build <family> <profile> <region>` — one
# matrix cell, materialised next to (never into) the full `out/` the fingerprint
# baseline is keyed on.
*/out-*/
serif/work/
serif/out/
serif/dist/
sans/work/
sans/out/
sans/dist/
sans/samples/rendered/
pixel/work/
pixel/out/
pixel/dist/
pixel/samples/rendered/
handwriting/work/
handwriting/out/
handwriting/dist/
handwriting/samples/rendered/
typewriter/work/
typewriter/out/
typewriter/dist/
typewriter/samples/rendered/
rounded/work/
rounded/out/
rounded/dist/
rounded/samples/rendered/
casual/work/
casual/out/
casual/dist/
casual/samples/rendered/
**/.pc/
**/node_modules/
*.ttf
*.otf
*.ttc
!**/patches/**

# Nix
result
result-*
.direnv/

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Fingerprint working dir (CI writes the current run here)
fingerprints-current/
.vercel
.env*
